{
  "name": "open-quran-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "gates": "bun run typecheck && bun run lint && bun run format:check && bun run test:unit && bun run test:e2e",
    "gates:ci": "bun run typecheck && bun run lint && bun run format:check && bun run test:unit",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run --coverage --pool=threads --fileParallelism=false --maxWorkers=1 --minWorkers=1",
    "test:unit:watch": "vitest",
    "test:e2e": "node scripts/run-playwright.js",
    "test:e2e:ui": "PLAYWRIGHT_SKIP_PROBE=1 playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "sync": "bun run scripts/sync.ts",
    "generate-phrases": "bun run scripts/generate-phrases.ts all",
    "generate-root-phrases": "bun run scripts/generate-phrases.ts root"
  },
  "dependencies": {
    "@blocknote/core": "^0.42.3",
    "@blocknote/mantine": "^0.42.3",
    "@blocknote/react": "^0.42.3",
    "@google/genai": "^1.30.0",
    "@mantine/core": "^8.3.9",
    "@tanstack/react-virtual": "^3.13.18",
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^2.1.6",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "playwright": "^1.56.1",
    "prettier": "^3.4.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.2.0",
    "vitest": "^2.1.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
