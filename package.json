{
  "name": "openquranreader-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/run-workspaces.ts build",
    "lint": "bun scripts/run-workspaces.ts lint",
    "typecheck": "bun scripts/run-workspaces.ts typecheck",
    "test": "bun scripts/run-workspaces.ts test",
    "dev": "bun run --cwd apps/web dev",
    "gates": "bun scripts/gates.ts"
  },
  "packageManager": "bun@1.2.14",
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "9.9.0",
    "globals": "^16.3.0"
  },
  "dependencies": {}
}