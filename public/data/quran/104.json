{"surahId":104,"verses":[{"id":6180,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَيْلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍ"},{"id":6181,"numberInSurah":2,"text_uthmani":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","text_simple":"الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ"},{"id":6182,"numberInSurah":3,"text_uthmani":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","text_simple":"يَحْسَبُ أَنَّ مَالَهُ أَخْلَدَهُ"},{"id":6183,"numberInSurah":4,"text_uthmani":"كَلَّا لَيُنبَذَنَّ فِى ٱلْحُطَمَةِ","text_simple":"كَلَّا لَيُنْبَذَنَّ فِي الْحُطَمَةِ"},{"id":6184,"numberInSurah":5,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","text_simple":"وَمَا أَدْرَاكَ مَا الْحُطَمَةُ"},{"id":6185,"numberInSurah":6,"text_uthmani":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","text_simple":"نَارُ اللَّهِ الْمُوقَدَةُ"},{"id":6186,"numberInSurah":7,"text_uthmani":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","text_simple":"الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ"},{"id":6187,"numberInSurah":8,"text_uthmani":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","text_simple":"إِنَّهَا عَلَيْهِمْ مُؤْصَدَةٌ"},{"id":6188,"numberInSurah":9,"text_uthmani":"فِى عَمَدٍ مُّمَدَّدَةٍ","text_simple":"فِي عَمَدٍ مُمَدَّدَةٍ"}]}