{"surahId":88,"verses":[{"id":5968,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ"},{"id":5969,"numberInSurah":2,"text_uthmani":"وُجُوهٌ يَوْمَئِذٍ خَٰشِعَةٌ","text_simple":"وُجُوهٌ يَوْمَئِذٍ خَاشِعَةٌ"},{"id":5970,"numberInSurah":3,"text_uthmani":"عَامِلَةٌ نَّاصِبَةٌ","text_simple":"عَامِلَةٌ نَاصِبَةٌ"},{"id":5971,"numberInSurah":4,"text_uthmani":"تَصْلَىٰ نَارًا حَامِيَةً","text_simple":"تَصْلَىٰ نَارًا حَامِيَةً"},{"id":5972,"numberInSurah":5,"text_uthmani":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ","text_simple":"تُسْقَىٰ مِنْ عَيْنٍ آنِيَةٍ"},{"id":5973,"numberInSurah":6,"text_uthmani":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ","text_simple":"لَيْسَ لَهُمْ طَعَامٌ إِلَّا مِنْ ضَرِيعٍ"},{"id":5974,"numberInSurah":7,"text_uthmani":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ","text_simple":"لَا يُسْمِنُ وَلَا يُغْنِي مِنْ جُوعٍ"},{"id":5975,"numberInSurah":8,"text_uthmani":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ","text_simple":"وُجُوهٌ يَوْمَئِذٍ نَاعِمَةٌ"},{"id":5976,"numberInSurah":9,"text_uthmani":"لِّسَعْيِهَا رَاضِيَةٌ","text_simple":"لِسَعْيِهَا رَاضِيَةٌ"},{"id":5977,"numberInSurah":10,"text_uthmani":"فِى جَنَّةٍ عَالِيَةٍ","text_simple":"فِي جَنَّةٍ عَالِيَةٍ"},{"id":5978,"numberInSurah":11,"text_uthmani":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةً","text_simple":"لَا تَسْمَعُ فِيهَا لَاغِيَةً"},{"id":5979,"numberInSurah":12,"text_uthmani":"فِيهَا عَيْنٌ جَارِيَةٌ","text_simple":"فِيهَا عَيْنٌ جَارِيَةٌ"},{"id":5980,"numberInSurah":13,"text_uthmani":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ","text_simple":"فِيهَا سُرُرٌ مَرْفُوعَةٌ"},{"id":5981,"numberInSurah":14,"text_uthmani":"وَأَكْوَابٌ مَّوْضُوعَةٌ","text_simple":"وَأَكْوَابٌ مَوْضُوعَةٌ"},{"id":5982,"numberInSurah":15,"text_uthmani":"وَنَمَارِقُ مَصْفُوفَةٌ","text_simple":"وَنَمَارِقُ مَصْفُوفَةٌ"},{"id":5983,"numberInSurah":16,"text_uthmani":"وَزَرَابِىُّ مَبْثُوثَةٌ","text_simple":"وَزَرَابِيُّ مَبْثُوثَةٌ"},{"id":5984,"numberInSurah":17,"text_uthmani":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","text_simple":"أَفَلَا يَنْظُرُونَ إِلَى الْإِبِلِ كَيْفَ خُلِقَتْ"},{"id":5985,"numberInSurah":18,"text_uthmani":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","text_simple":"وَإِلَى السَّمَاءِ كَيْفَ رُفِعَتْ"},{"id":5986,"numberInSurah":19,"text_uthmani":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","text_simple":"وَإِلَى الْجِبَالِ كَيْفَ نُصِبَتْ"},{"id":5987,"numberInSurah":20,"text_uthmani":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","text_simple":"وَإِلَى الْأَرْضِ كَيْفَ سُطِحَتْ"},{"id":5988,"numberInSurah":21,"text_uthmani":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ","text_simple":"فَذَكِّرْ إِنَّمَا أَنْتَ مُذَكِّرٌ"},{"id":5989,"numberInSurah":22,"text_uthmani":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","text_simple":"لَسْتَ عَلَيْهِمْ بِمُصَيْطِرٍ"},{"id":5990,"numberInSurah":23,"text_uthmani":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","text_simple":"إِلَّا مَنْ تَوَلَّىٰ وَكَفَرَ"},{"id":5991,"numberInSurah":24,"text_uthmani":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","text_simple":"فَيُعَذِّبُهُ اللَّهُ الْعَذَابَ الْأَكْبَرَ"},{"id":5992,"numberInSurah":25,"text_uthmani":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","text_simple":"إِنَّ إِلَيْنَا إِيَابَهُمْ"},{"id":5993,"numberInSurah":26,"text_uthmani":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","text_simple":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُمْ"}]}