{"surahId":113,"verses":[{"id":6226,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ"},{"id":6227,"numberInSurah":2,"text_uthmani":"مِن شَرِّ مَا خَلَقَ","text_simple":"مِنْ شَرِّ مَا خَلَقَ"},{"id":6228,"numberInSurah":3,"text_uthmani":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","text_simple":"وَمِنْ شَرِّ غَاسِقٍ إِذَا وَقَبَ"},{"id":6229,"numberInSurah":4,"text_uthmani":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","text_simple":"وَمِنْ شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ"},{"id":6230,"numberInSurah":5,"text_uthmani":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","text_simple":"وَمِنْ شَرِّ حَاسِدٍ إِذَا حَسَدَ"}]}