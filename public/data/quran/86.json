{"surahId":86,"verses":[{"id":5932,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالسَّمَاءِ وَالطَّارِقِ"},{"id":5933,"numberInSurah":2,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","text_simple":"وَمَا أَدْرَاكَ مَا الطَّارِقُ"},{"id":5934,"numberInSurah":3,"text_uthmani":"ٱلنَّجْمُ ٱلثَّاقِبُ","text_simple":"النَّجْمُ الثَّاقِبُ"},{"id":5935,"numberInSurah":4,"text_uthmani":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","text_simple":"إِنْ كُلُّ نَفْسٍ لَمَّا عَلَيْهَا حَافِظٌ"},{"id":5936,"numberInSurah":5,"text_uthmani":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","text_simple":"فَلْيَنْظُرِ الْإِنْسَانُ مِمَّ خُلِقَ"},{"id":5937,"numberInSurah":6,"text_uthmani":"خُلِقَ مِن مَّآءٍ دَافِقٍ","text_simple":"خُلِقَ مِنْ مَاءٍ دَافِقٍ"},{"id":5938,"numberInSurah":7,"text_uthmani":"يَخْرُجُ مِن بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","text_simple":"يَخْرُجُ مِنْ بَيْنِ الصُّلْبِ وَالتَّرَائِبِ"},{"id":5939,"numberInSurah":8,"text_uthmani":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ","text_simple":"إِنَّهُ عَلَىٰ رَجْعِهِ لَقَادِرٌ"},{"id":5940,"numberInSurah":9,"text_uthmani":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","text_simple":"يَوْمَ تُبْلَى السَّرَائِرُ"},{"id":5941,"numberInSurah":10,"text_uthmani":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ","text_simple":"فَمَا لَهُ مِنْ قُوَّةٍ وَلَا نَاصِرٍ"},{"id":5942,"numberInSurah":11,"text_uthmani":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","text_simple":"وَالسَّمَاءِ ذَاتِ الرَّجْعِ"},{"id":5943,"numberInSurah":12,"text_uthmani":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","text_simple":"وَالْأَرْضِ ذَاتِ الصَّدْعِ"},{"id":5944,"numberInSurah":13,"text_uthmani":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ","text_simple":"إِنَّهُ لَقَوْلٌ فَصْلٌ"},{"id":5945,"numberInSurah":14,"text_uthmani":"وَمَا هُوَ بِٱلْهَزْلِ","text_simple":"وَمَا هُوَ بِالْهَزْلِ"},{"id":5946,"numberInSurah":15,"text_uthmani":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","text_simple":"إِنَّهُمْ يَكِيدُونَ كَيْدًا"},{"id":5947,"numberInSurah":16,"text_uthmani":"وَأَكِيدُ كَيْدًا","text_simple":"وَأَكِيدُ كَيْدًا"},{"id":5948,"numberInSurah":17,"text_uthmani":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًا","text_simple":"فَمَهِّلِ الْكَافِرِينَ أَمْهِلْهُمْ رُوَيْدًا"}]}