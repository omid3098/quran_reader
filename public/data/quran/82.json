{"surahId":82,"verses":[{"id":5830,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِذَا السَّمَاءُ انْفَطَرَتْ"},{"id":5831,"numberInSurah":2,"text_uthmani":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","text_simple":"وَإِذَا الْكَوَاكِبُ انْتَثَرَتْ"},{"id":5832,"numberInSurah":3,"text_uthmani":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","text_simple":"وَإِذَا الْبِحَارُ فُجِّرَتْ"},{"id":5833,"numberInSurah":4,"text_uthmani":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","text_simple":"وَإِذَا الْقُبُورُ بُعْثِرَتْ"},{"id":5834,"numberInSurah":5,"text_uthmani":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","text_simple":"عَلِمَتْ نَفْسٌ مَا قَدَّمَتْ وَأَخَّرَتْ"},{"id":5835,"numberInSurah":6,"text_uthmani":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","text_simple":"يَا أَيُّهَا الْإِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ"},{"id":5836,"numberInSurah":7,"text_uthmani":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","text_simple":"الَّذِي خَلَقَكَ فَسَوَّاكَ فَعَدَلَكَ"},{"id":5837,"numberInSurah":8,"text_uthmani":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ","text_simple":"فِي أَيِّ صُورَةٍ مَا شَاءَ رَكَّبَكَ"},{"id":5838,"numberInSurah":9,"text_uthmani":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","text_simple":"كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ"},{"id":5839,"numberInSurah":10,"text_uthmani":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","text_simple":"وَإِنَّ عَلَيْكُمْ لَحَافِظِينَ"},{"id":5840,"numberInSurah":11,"text_uthmani":"كِرَامًا كَٰتِبِينَ","text_simple":"كِرَامًا كَاتِبِينَ"},{"id":5841,"numberInSurah":12,"text_uthmani":"يَعْلَمُونَ مَا تَفْعَلُونَ","text_simple":"يَعْلَمُونَ مَا تَفْعَلُونَ"},{"id":5842,"numberInSurah":13,"text_uthmani":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","text_simple":"إِنَّ الْأَبْرَارَ لَفِي نَعِيمٍ"},{"id":5843,"numberInSurah":14,"text_uthmani":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ","text_simple":"وَإِنَّ الْفُجَّارَ لَفِي جَحِيمٍ"},{"id":5844,"numberInSurah":15,"text_uthmani":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","text_simple":"يَصْلَوْنَهَا يَوْمَ الدِّينِ"},{"id":5845,"numberInSurah":16,"text_uthmani":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","text_simple":"وَمَا هُمْ عَنْهَا بِغَائِبِينَ"},{"id":5846,"numberInSurah":17,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","text_simple":"وَمَا أَدْرَاكَ مَا يَوْمُ الدِّينِ"},{"id":5847,"numberInSurah":18,"text_uthmani":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","text_simple":"ثُمَّ مَا أَدْرَاكَ مَا يَوْمُ الدِّينِ"},{"id":5848,"numberInSurah":19,"text_uthmani":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ","text_simple":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِنَفْسٍ شَيْئًا وَالْأَمْرُ يَوْمَئِذٍ لِلَّهِ"}]}