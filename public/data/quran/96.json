{"surahId":96,"verses":[{"id":6107,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ"},{"id":6108,"numberInSurah":2,"text_uthmani":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","text_simple":"خَلَقَ الْإِنْسَانَ مِنْ عَلَقٍ"},{"id":6109,"numberInSurah":3,"text_uthmani":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","text_simple":"اقْرَأْ وَرَبُّكَ الْأَكْرَمُ"},{"id":6110,"numberInSurah":4,"text_uthmani":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","text_simple":"الَّذِي عَلَّمَ بِالْقَلَمِ"},{"id":6111,"numberInSurah":5,"text_uthmani":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","text_simple":"عَلَّمَ الْإِنْسَانَ مَا لَمْ يَعْلَمْ"},{"id":6112,"numberInSurah":6,"text_uthmani":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","text_simple":"كَلَّا إِنَّ الْإِنْسَانَ لَيَطْغَىٰ"},{"id":6113,"numberInSurah":7,"text_uthmani":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","text_simple":"أَنْ رَآهُ اسْتَغْنَىٰ"},{"id":6114,"numberInSurah":8,"text_uthmani":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","text_simple":"إِنَّ إِلَىٰ رَبِّكَ الرُّجْعَىٰ"},{"id":6115,"numberInSurah":9,"text_uthmani":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","text_simple":"أَرَأَيْتَ الَّذِي يَنْهَىٰ"},{"id":6116,"numberInSurah":10,"text_uthmani":"عَبْدًا إِذَا صَلَّىٰٓ","text_simple":"عَبْدًا إِذَا صَلَّىٰ"},{"id":6117,"numberInSurah":11,"text_uthmani":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","text_simple":"أَرَأَيْتَ إِنْ كَانَ عَلَى الْهُدَىٰ"},{"id":6118,"numberInSurah":12,"text_uthmani":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","text_simple":"أَوْ أَمَرَ بِالتَّقْوَىٰ"},{"id":6119,"numberInSurah":13,"text_uthmani":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","text_simple":"أَرَأَيْتَ إِنْ كَذَّبَ وَتَوَلَّىٰ"},{"id":6120,"numberInSurah":14,"text_uthmani":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","text_simple":"أَلَمْ يَعْلَمْ بِأَنَّ اللَّهَ يَرَىٰ"},{"id":6121,"numberInSurah":15,"text_uthmani":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًا بِٱلنَّاصِيَةِ","text_simple":"كَلَّا لَئِنْ لَمْ يَنْتَهِ لَنَسْفَعًا بِالنَّاصِيَةِ"},{"id":6122,"numberInSurah":16,"text_uthmani":"نَاصِيَةٍ كَٰذِبَةٍ خَاطِئَةٍ","text_simple":"نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ"},{"id":6123,"numberInSurah":17,"text_uthmani":"فَلْيَدْعُ نَادِيَهُۥ","text_simple":"فَلْيَدْعُ نَادِيَهُ"},{"id":6124,"numberInSurah":18,"text_uthmani":"سَنَدْعُ ٱلزَّبَانِيَةَ","text_simple":"سَنَدْعُ الزَّبَانِيَةَ"},{"id":6125,"numberInSurah":19,"text_uthmani":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب","text_simple":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ"}]}