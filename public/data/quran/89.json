{"surahId":89,"verses":[{"id":5994,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالْفَجْرِ"},{"id":5995,"numberInSurah":2,"text_uthmani":"وَلَيَالٍ عَشْرٍ","text_simple":"وَلَيَالٍ عَشْرٍ"},{"id":5996,"numberInSurah":3,"text_uthmani":"وَٱلشَّفْعِ وَٱلْوَتْرِ","text_simple":"وَالشَّفْعِ وَالْوَتْرِ"},{"id":5997,"numberInSurah":4,"text_uthmani":"وَٱلَّيْلِ إِذَا يَسْرِ","text_simple":"وَاللَّيْلِ إِذَا يَسْرِ"},{"id":5998,"numberInSurah":5,"text_uthmani":"هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ","text_simple":"هَلْ فِي ذَٰلِكَ قَسَمٌ لِذِي حِجْرٍ"},{"id":5999,"numberInSurah":6,"text_uthmani":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ","text_simple":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"},{"id":6000,"numberInSurah":7,"text_uthmani":"إِرَمَ ذَاتِ ٱلْعِمَادِ","text_simple":"إِرَمَ ذَاتِ الْعِمَادِ"},{"id":6001,"numberInSurah":8,"text_uthmani":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ","text_simple":"الَّتِي لَمْ يُخْلَقْ مِثْلُهَا فِي الْبِلَادِ"},{"id":6002,"numberInSurah":9,"text_uthmani":"وَثَمُودَ ٱلَّذِينَ جَابُوا ٱلصَّخْرَ بِٱلْوَادِ","text_simple":"وَثَمُودَ الَّذِينَ جَابُوا الصَّخْرَ بِالْوَادِ"},{"id":6003,"numberInSurah":10,"text_uthmani":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ","text_simple":"وَفِرْعَوْنَ ذِي الْأَوْتَادِ"},{"id":6004,"numberInSurah":11,"text_uthmani":"ٱلَّذِينَ طَغَوْا فِى ٱلْبِلَٰدِ","text_simple":"الَّذِينَ طَغَوْا فِي الْبِلَادِ"},{"id":6005,"numberInSurah":12,"text_uthmani":"فَأَكْثَرُوا فِيهَا ٱلْفَسَادَ","text_simple":"فَأَكْثَرُوا فِيهَا الْفَسَادَ"},{"id":6006,"numberInSurah":13,"text_uthmani":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ","text_simple":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ"},{"id":6007,"numberInSurah":14,"text_uthmani":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ","text_simple":"إِنَّ رَبَّكَ لَبِالْمِرْصَادِ"},{"id":6008,"numberInSurah":15,"text_uthmani":"فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ","text_simple":"فَأَمَّا الْإِنْسَانُ إِذَا مَا ابْتَلَاهُ رَبُّهُ فَأَكْرَمَهُ وَنَعَّمَهُ فَيَقُولُ رَبِّي أَكْرَمَنِ"},{"id":6009,"numberInSurah":16,"text_uthmani":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ","text_simple":"وَأَمَّا إِذَا مَا ابْتَلَاهُ فَقَدَرَ عَلَيْهِ رِزْقَهُ فَيَقُولُ رَبِّي أَهَانَنِ"},{"id":6010,"numberInSurah":17,"text_uthmani":"كَلَّا بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ","text_simple":"كَلَّا بَلْ لَا تُكْرِمُونَ الْيَتِيمَ"},{"id":6011,"numberInSurah":18,"text_uthmani":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","text_simple":"وَلَا تَحَاضُّونَ عَلَىٰ طَعَامِ الْمِسْكِينِ"},{"id":6012,"numberInSurah":19,"text_uthmani":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا","text_simple":"وَتَأْكُلُونَ التُّرَاثَ أَكْلًا لَمًّا"},{"id":6013,"numberInSurah":20,"text_uthmani":"وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا","text_simple":"وَتُحِبُّونَ الْمَالَ حُبًّا جَمًّا"},{"id":6014,"numberInSurah":21,"text_uthmani":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا","text_simple":"كَلَّا إِذَا دُكَّتِ الْأَرْضُ دَكًّا دَكًّا"},{"id":6015,"numberInSurah":22,"text_uthmani":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا","text_simple":"وَجَاءَ رَبُّكَ وَالْمَلَكُ صَفًّا صَفًّا"},{"id":6016,"numberInSurah":23,"text_uthmani":"وَجِاىٓءَ يَوْمَئِذٍ بِجَهَنَّمَ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ","text_simple":"وَجِيءَ يَوْمَئِذٍ بِجَهَنَّمَ يَوْمَئِذٍ يَتَذَكَّرُ الْإِنْسَانُ وَأَنَّىٰ لَهُ الذِّكْرَىٰ"},{"id":6017,"numberInSurah":24,"text_uthmani":"يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى","text_simple":"يَقُولُ يَا لَيْتَنِي قَدَّمْتُ لِحَيَاتِي"},{"id":6018,"numberInSurah":25,"text_uthmani":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ","text_simple":"فَيَوْمَئِذٍ لَا يُعَذِّبُ عَذَابَهُ أَحَدٌ"},{"id":6019,"numberInSurah":26,"text_uthmani":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ","text_simple":"وَلَا يُوثِقُ وَثَاقَهُ أَحَدٌ"},{"id":6020,"numberInSurah":27,"text_uthmani":"يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ","text_simple":"يَا أَيَّتُهَا النَّفْسُ الْمُطْمَئِنَّةُ"},{"id":6021,"numberInSurah":28,"text_uthmani":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً","text_simple":"ارْجِعِي إِلَىٰ رَبِّكِ رَاضِيَةً مَرْضِيَّةً"},{"id":6022,"numberInSurah":29,"text_uthmani":"فَٱدْخُلِى فِى عِبَٰدِى","text_simple":"فَادْخُلِي فِي عِبَادِي"},{"id":6023,"numberInSurah":30,"text_uthmani":"وَٱدْخُلِى جَنَّتِى","text_simple":"وَادْخُلِي جَنَّتِي"}]}