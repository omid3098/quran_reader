{"surahId":91,"verses":[{"id":6044,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالشَّمْسِ وَضُحَاهَا"},{"id":6045,"numberInSurah":2,"text_uthmani":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","text_simple":"وَالْقَمَرِ إِذَا تَلَاهَا"},{"id":6046,"numberInSurah":3,"text_uthmani":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","text_simple":"وَالنَّهَارِ إِذَا جَلَّاهَا"},{"id":6047,"numberInSurah":4,"text_uthmani":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","text_simple":"وَاللَّيْلِ إِذَا يَغْشَاهَا"},{"id":6048,"numberInSurah":5,"text_uthmani":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","text_simple":"وَالسَّمَاءِ وَمَا بَنَاهَا"},{"id":6049,"numberInSurah":6,"text_uthmani":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","text_simple":"وَالْأَرْضِ وَمَا طَحَاهَا"},{"id":6050,"numberInSurah":7,"text_uthmani":"وَنَفْسٍ وَمَا سَوَّىٰهَا","text_simple":"وَنَفْسٍ وَمَا سَوَّاهَا"},{"id":6051,"numberInSurah":8,"text_uthmani":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","text_simple":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَاهَا"},{"id":6052,"numberInSurah":9,"text_uthmani":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","text_simple":"قَدْ أَفْلَحَ مَنْ زَكَّاهَا"},{"id":6053,"numberInSurah":10,"text_uthmani":"وَقَدْ خَابَ مَن دَسَّىٰهَا","text_simple":"وَقَدْ خَابَ مَنْ دَسَّاهَا"},{"id":6054,"numberInSurah":11,"text_uthmani":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","text_simple":"كَذَّبَتْ ثَمُودُ بِطَغْوَاهَا"},{"id":6055,"numberInSurah":12,"text_uthmani":"إِذِ ٱنبَعَثَ أَشْقَىٰهَا","text_simple":"إِذِ انْبَعَثَ أَشْقَاهَا"},{"id":6056,"numberInSurah":13,"text_uthmani":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا","text_simple":"فَقَالَ لَهُمْ رَسُولُ اللَّهِ نَاقَةَ اللَّهِ وَسُقْيَاهَا"},{"id":6057,"numberInSurah":14,"text_uthmani":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنبِهِمْ فَسَوَّىٰهَا","text_simple":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُمْ بِذَنْبِهِمْ فَسَوَّاهَا"},{"id":6058,"numberInSurah":15,"text_uthmani":"وَلَا يَخَافُ عُقْبَٰهَا","text_simple":"وَلَا يَخَافُ عُقْبَاهَا"}]}