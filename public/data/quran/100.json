{"surahId":100,"verses":[{"id":6147,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًا","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالْعَادِيَاتِ ضَبْحًا"},{"id":6148,"numberInSurah":2,"text_uthmani":"فَٱلْمُورِيَٰتِ قَدْحًا","text_simple":"فَالْمُورِيَاتِ قَدْحًا"},{"id":6149,"numberInSurah":3,"text_uthmani":"فَٱلْمُغِيرَٰتِ صُبْحًا","text_simple":"فَالْمُغِيرَاتِ صُبْحًا"},{"id":6150,"numberInSurah":4,"text_uthmani":"فَأَثَرْنَ بِهِۦ نَقْعًا","text_simple":"فَأَثَرْنَ بِهِ نَقْعًا"},{"id":6151,"numberInSurah":5,"text_uthmani":"فَوَسَطْنَ بِهِۦ جَمْعًا","text_simple":"فَوَسَطْنَ بِهِ جَمْعًا"},{"id":6152,"numberInSurah":6,"text_uthmani":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌ","text_simple":"إِنَّ الْإِنْسَانَ لِرَبِّهِ لَكَنُودٌ"},{"id":6153,"numberInSurah":7,"text_uthmani":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ","text_simple":"وَإِنَّهُ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ"},{"id":6154,"numberInSurah":8,"text_uthmani":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","text_simple":"وَإِنَّهُ لِحُبِّ الْخَيْرِ لَشَدِيدٌ"},{"id":6155,"numberInSurah":9,"text_uthmani":"أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","text_simple":"أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِي الْقُبُورِ"},{"id":6156,"numberInSurah":10,"text_uthmani":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","text_simple":"وَحُصِّلَ مَا فِي الصُّدُورِ"},{"id":6157,"numberInSurah":11,"text_uthmani":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌ","text_simple":"إِنَّ رَبَّهُمْ بِهِمْ يَوْمَئِذٍ لَخَبِيرٌ"}]}