{"surahId":77,"verses":[{"id":5623,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًا","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالْمُرْسَلَاتِ عُرْفًا"},{"id":5624,"numberInSurah":2,"text_uthmani":"فَٱلْعَٰصِفَٰتِ عَصْفًا","text_simple":"فَالْعَاصِفَاتِ عَصْفًا"},{"id":5625,"numberInSurah":3,"text_uthmani":"وَٱلنَّٰشِرَٰتِ نَشْرًا","text_simple":"وَالنَّاشِرَاتِ نَشْرًا"},{"id":5626,"numberInSurah":4,"text_uthmani":"فَٱلْفَٰرِقَٰتِ فَرْقًا","text_simple":"فَالْفَارِقَاتِ فَرْقًا"},{"id":5627,"numberInSurah":5,"text_uthmani":"فَٱلْمُلْقِيَٰتِ ذِكْرًا","text_simple":"فَالْمُلْقِيَاتِ ذِكْرًا"},{"id":5628,"numberInSurah":6,"text_uthmani":"عُذْرًا أَوْ نُذْرًا","text_simple":"عُذْرًا أَوْ نُذْرًا"},{"id":5629,"numberInSurah":7,"text_uthmani":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ","text_simple":"إِنَّمَا تُوعَدُونَ لَوَاقِعٌ"},{"id":5630,"numberInSurah":8,"text_uthmani":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","text_simple":"فَإِذَا النُّجُومُ طُمِسَتْ"},{"id":5631,"numberInSurah":9,"text_uthmani":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","text_simple":"وَإِذَا السَّمَاءُ فُرِجَتْ"},{"id":5632,"numberInSurah":10,"text_uthmani":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","text_simple":"وَإِذَا الْجِبَالُ نُسِفَتْ"},{"id":5633,"numberInSurah":11,"text_uthmani":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","text_simple":"وَإِذَا الرُّسُلُ أُقِّتَتْ"},{"id":5634,"numberInSurah":12,"text_uthmani":"لِأَىِّ يَوْمٍ أُجِّلَتْ","text_simple":"لِأَيِّ يَوْمٍ أُجِّلَتْ"},{"id":5635,"numberInSurah":13,"text_uthmani":"لِيَوْمِ ٱلْفَصْلِ","text_simple":"لِيَوْمِ الْفَصْلِ"},{"id":5636,"numberInSurah":14,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","text_simple":"وَمَا أَدْرَاكَ مَا يَوْمُ الْفَصْلِ"},{"id":5637,"numberInSurah":15,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","text_simple":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"},{"id":5638,"numberInSurah":16,"text_uthmani":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","text_simple":"أَلَمْ نُهْلِكِ الْأَوَّلِينَ"},{"id":5639,"numberInSurah":17,"text_uthmani":"ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ","text_simple":"ثُمَّ نُتْبِعُهُمُ الْآخِرِينَ"},{"id":5640,"numberInSurah":18,"text_uthmani":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","text_simple":"كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَ"},{"id":5641,"numberInSurah":19,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","text_simple":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"},{"id":5642,"numberInSurah":20,"text_uthmani":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ","text_simple":"أَلَمْ نَخْلُقْكُمْ مِنْ مَاءٍ مَهِينٍ"},{"id":5643,"numberInSurah":21,"text_uthmani":"فَجَعَلْنَٰهُ فِى قَرَارٍ مَّكِينٍ","text_simple":"فَجَعَلْنَاهُ فِي قَرَارٍ مَكِينٍ"},{"id":5644,"numberInSurah":22,"text_uthmani":"إِلَىٰ قَدَرٍ مَّعْلُومٍ","text_simple":"إِلَىٰ قَدَرٍ مَعْلُومٍ"},{"id":5645,"numberInSurah":23,"text_uthmani":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ","text_simple":"فَقَدَرْنَا فَنِعْمَ الْقَادِرُونَ"},{"id":5646,"numberInSurah":24,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","text_simple":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"},{"id":5647,"numberInSurah":25,"text_uthmani":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","text_simple":"أَلَمْ نَجْعَلِ الْأَرْضَ كِفَاتًا"},{"id":5648,"numberInSurah":26,"text_uthmani":"أَحْيَآءً وَأَمْوَٰتًا","text_simple":"أَحْيَاءً وَأَمْوَاتًا"},{"id":5649,"numberInSurah":27,"text_uthmani":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍ وَأَسْقَيْنَٰكُم مَّآءً فُرَاتًا","text_simple":"وَجَعَلْنَا فِيهَا رَوَاسِيَ شَامِخَاتٍ وَأَسْقَيْنَاكُمْ مَاءً فُرَاتًا"},{"id":5650,"numberInSurah":28,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","text_simple":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"},{"id":5651,"numberInSurah":29,"text_uthmani":"ٱنطَلِقُوٓا إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","text_simple":"انْطَلِقُوا إِلَىٰ مَا كُنْتُمْ بِهِ تُكَذِّبُونَ"},{"id":5652,"numberInSurah":30,"text_uthmani":"ٱنطَلِقُوٓا إِلَىٰ ظِلٍّ ذِى ثَلَٰثِ شُعَبٍ","text_simple":"انْطَلِقُوا إِلَىٰ ظِلٍّ ذِي ثَلَاثِ شُعَبٍ"},{"id":5653,"numberInSurah":31,"text_uthmani":"لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","text_simple":"لَا ظَلِيلٍ وَلَا يُغْنِي مِنَ اللَّهَبِ"},{"id":5654,"numberInSurah":32,"text_uthmani":"إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ","text_simple":"إِنَّهَا تَرْمِي بِشَرَرٍ كَالْقَصْرِ"},{"id":5655,"numberInSurah":33,"text_uthmani":"كَأَنَّهُۥ جِمَٰلَتٌ صُفْرٌ","text_simple":"كَأَنَّهُ جِمَالَتٌ صُفْرٌ"},{"id":5656,"numberInSurah":34,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","text_simple":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"},{"id":5657,"numberInSurah":35,"text_uthmani":"هَٰذَا يَوْمُ لَا يَنطِقُونَ","text_simple":"هَٰذَا يَوْمُ لَا يَنْطِقُونَ"},{"id":5658,"numberInSurah":36,"text_uthmani":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","text_simple":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"},{"id":5659,"numberInSurah":37,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","text_simple":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"},{"id":5660,"numberInSurah":38,"text_uthmani":"هَٰذَا يَوْمُ ٱلْفَصْلِ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ","text_simple":"هَٰذَا يَوْمُ الْفَصْلِ جَمَعْنَاكُمْ وَالْأَوَّلِينَ"},{"id":5661,"numberInSurah":39,"text_uthmani":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ","text_simple":"فَإِنْ كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ"},{"id":5662,"numberInSurah":40,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","text_simple":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"},{"id":5663,"numberInSurah":41,"text_uthmani":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍ وَعُيُونٍ","text_simple":"إِنَّ الْمُتَّقِينَ فِي ظِلَالٍ وَعُيُونٍ"},{"id":5664,"numberInSurah":42,"text_uthmani":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","text_simple":"وَفَوَاكِهَ مِمَّا يَشْتَهُونَ"},{"id":5665,"numberInSurah":43,"text_uthmani":"كُلُوا وَٱشْرَبُوا هَنِيٓـًٔا بِمَا كُنتُمْ تَعْمَلُونَ","text_simple":"كُلُوا وَاشْرَبُوا هَنِيئًا بِمَا كُنْتُمْ تَعْمَلُونَ"},{"id":5666,"numberInSurah":44,"text_uthmani":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","text_simple":"إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ"},{"id":5667,"numberInSurah":45,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","text_simple":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"},{"id":5668,"numberInSurah":46,"text_uthmani":"كُلُوا وَتَمَتَّعُوا قَلِيلًا إِنَّكُم مُّجْرِمُونَ","text_simple":"كُلُوا وَتَمَتَّعُوا قَلِيلًا إِنَّكُمْ مُجْرِمُونَ"},{"id":5669,"numberInSurah":47,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","text_simple":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"},{"id":5670,"numberInSurah":48,"text_uthmani":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا لَا يَرْكَعُونَ","text_simple":"وَإِذَا قِيلَ لَهُمُ ارْكَعُوا لَا يَرْكَعُونَ"},{"id":5671,"numberInSurah":49,"text_uthmani":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","text_simple":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ"},{"id":5672,"numberInSurah":50,"text_uthmani":"فَبِأَىِّ حَدِيثٍ بَعْدَهُۥ يُؤْمِنُونَ","text_simple":"فَبِأَيِّ حَدِيثٍ بَعْدَهُ يُؤْمِنُونَ"}]}