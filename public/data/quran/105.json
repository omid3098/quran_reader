{"surahId":105,"verses":[{"id":6189,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ"},{"id":6190,"numberInSurah":2,"text_uthmani":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ","text_simple":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِي تَضْلِيلٍ"},{"id":6191,"numberInSurah":3,"text_uthmani":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","text_simple":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"},{"id":6192,"numberInSurah":4,"text_uthmani":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ","text_simple":"تَرْمِيهِمْ بِحِجَارَةٍ مِنْ سِجِّيلٍ"},{"id":6193,"numberInSurah":5,"text_uthmani":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍ","text_simple":"فَجَعَلَهُمْ كَعَصْفٍ مَأْكُولٍ"}]}