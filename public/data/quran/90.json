{"surahId":90,"verses":[{"id":6024,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ لَا أُقْسِمُ بِهَٰذَا الْبَلَدِ"},{"id":6025,"numberInSurah":2,"text_uthmani":"وَأَنتَ حِلٌّ بِهَٰذَا ٱلْبَلَدِ","text_simple":"وَأَنْتَ حِلٌّ بِهَٰذَا الْبَلَدِ"},{"id":6026,"numberInSurah":3,"text_uthmani":"وَوَالِدٍ وَمَا وَلَدَ","text_simple":"وَوَالِدٍ وَمَا وَلَدَ"},{"id":6027,"numberInSurah":4,"text_uthmani":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ","text_simple":"لَقَدْ خَلَقْنَا الْإِنْسَانَ فِي كَبَدٍ"},{"id":6028,"numberInSurah":5,"text_uthmani":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ","text_simple":"أَيَحْسَبُ أَنْ لَنْ يَقْدِرَ عَلَيْهِ أَحَدٌ"},{"id":6029,"numberInSurah":6,"text_uthmani":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا","text_simple":"يَقُولُ أَهْلَكْتُ مَالًا لُبَدًا"},{"id":6030,"numberInSurah":7,"text_uthmani":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ","text_simple":"أَيَحْسَبُ أَنْ لَمْ يَرَهُ أَحَدٌ"},{"id":6031,"numberInSurah":8,"text_uthmani":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ","text_simple":"أَلَمْ نَجْعَلْ لَهُ عَيْنَيْنِ"},{"id":6032,"numberInSurah":9,"text_uthmani":"وَلِسَانًا وَشَفَتَيْنِ","text_simple":"وَلِسَانًا وَشَفَتَيْنِ"},{"id":6033,"numberInSurah":10,"text_uthmani":"وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ","text_simple":"وَهَدَيْنَاهُ النَّجْدَيْنِ"},{"id":6034,"numberInSurah":11,"text_uthmani":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ","text_simple":"فَلَا اقْتَحَمَ الْعَقَبَةَ"},{"id":6035,"numberInSurah":12,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ","text_simple":"وَمَا أَدْرَاكَ مَا الْعَقَبَةُ"},{"id":6036,"numberInSurah":13,"text_uthmani":"فَكُّ رَقَبَةٍ","text_simple":"فَكُّ رَقَبَةٍ"},{"id":6037,"numberInSurah":14,"text_uthmani":"أَوْ إِطْعَٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ","text_simple":"أَوْ إِطْعَامٌ فِي يَوْمٍ ذِي مَسْغَبَةٍ"},{"id":6038,"numberInSurah":15,"text_uthmani":"يَتِيمًا ذَا مَقْرَبَةٍ","text_simple":"يَتِيمًا ذَا مَقْرَبَةٍ"},{"id":6039,"numberInSurah":16,"text_uthmani":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ","text_simple":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ"},{"id":6040,"numberInSurah":17,"text_uthmani":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا وَتَوَاصَوْا بِٱلصَّبْرِ وَتَوَاصَوْا بِٱلْمَرْحَمَةِ","text_simple":"ثُمَّ كَانَ مِنَ الَّذِينَ آمَنُوا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِ"},{"id":6041,"numberInSurah":18,"text_uthmani":"أُولَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ","text_simple":"أُولَٰئِكَ أَصْحَابُ الْمَيْمَنَةِ"},{"id":6042,"numberInSurah":19,"text_uthmani":"وَٱلَّذِينَ كَفَرُوا بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","text_simple":"وَالَّذِينَ كَفَرُوا بِآيَاتِنَا هُمْ أَصْحَابُ الْمَشْأَمَةِ"},{"id":6043,"numberInSurah":20,"text_uthmani":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌ","text_simple":"عَلَيْهِمْ نَارٌ مُؤْصَدَةٌ"}]}