{"surahId":81,"verses":[{"id":5801,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِذَا الشَّمْسُ كُوِّرَتْ"},{"id":5802,"numberInSurah":2,"text_uthmani":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","text_simple":"وَإِذَا النُّجُومُ انْكَدَرَتْ"},{"id":5803,"numberInSurah":3,"text_uthmani":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","text_simple":"وَإِذَا الْجِبَالُ سُيِّرَتْ"},{"id":5804,"numberInSurah":4,"text_uthmani":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","text_simple":"وَإِذَا الْعِشَارُ عُطِّلَتْ"},{"id":5805,"numberInSurah":5,"text_uthmani":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","text_simple":"وَإِذَا الْوُحُوشُ حُشِرَتْ"},{"id":5806,"numberInSurah":6,"text_uthmani":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","text_simple":"وَإِذَا الْبِحَارُ سُجِّرَتْ"},{"id":5807,"numberInSurah":7,"text_uthmani":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","text_simple":"وَإِذَا النُّفُوسُ زُوِّجَتْ"},{"id":5808,"numberInSurah":8,"text_uthmani":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","text_simple":"وَإِذَا الْمَوْءُودَةُ سُئِلَتْ"},{"id":5809,"numberInSurah":9,"text_uthmani":"بِأَىِّ ذَنبٍ قُتِلَتْ","text_simple":"بِأَيِّ ذَنْبٍ قُتِلَتْ"},{"id":5810,"numberInSurah":10,"text_uthmani":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","text_simple":"وَإِذَا الصُّحُفُ نُشِرَتْ"},{"id":5811,"numberInSurah":11,"text_uthmani":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","text_simple":"وَإِذَا السَّمَاءُ كُشِطَتْ"},{"id":5812,"numberInSurah":12,"text_uthmani":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","text_simple":"وَإِذَا الْجَحِيمُ سُعِّرَتْ"},{"id":5813,"numberInSurah":13,"text_uthmani":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","text_simple":"وَإِذَا الْجَنَّةُ أُزْلِفَتْ"},{"id":5814,"numberInSurah":14,"text_uthmani":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","text_simple":"عَلِمَتْ نَفْسٌ مَا أَحْضَرَتْ"},{"id":5815,"numberInSurah":15,"text_uthmani":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","text_simple":"فَلَا أُقْسِمُ بِالْخُنَّسِ"},{"id":5816,"numberInSurah":16,"text_uthmani":"ٱلْجَوَارِ ٱلْكُنَّسِ","text_simple":"الْجَوَارِ الْكُنَّسِ"},{"id":5817,"numberInSurah":17,"text_uthmani":"وَٱلَّيْلِ إِذَا عَسْعَسَ","text_simple":"وَاللَّيْلِ إِذَا عَسْعَسَ"},{"id":5818,"numberInSurah":18,"text_uthmani":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","text_simple":"وَالصُّبْحِ إِذَا تَنَفَّسَ"},{"id":5819,"numberInSurah":19,"text_uthmani":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","text_simple":"إِنَّهُ لَقَوْلُ رَسُولٍ كَرِيمٍ"},{"id":5820,"numberInSurah":20,"text_uthmani":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","text_simple":"ذِي قُوَّةٍ عِنْدَ ذِي الْعَرْشِ مَكِينٍ"},{"id":5821,"numberInSurah":21,"text_uthmani":"مُّطَاعٍ ثَمَّ أَمِينٍ","text_simple":"مُطَاعٍ ثَمَّ أَمِينٍ"},{"id":5822,"numberInSurah":22,"text_uthmani":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","text_simple":"وَمَا صَاحِبُكُمْ بِمَجْنُونٍ"},{"id":5823,"numberInSurah":23,"text_uthmani":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","text_simple":"وَلَقَدْ رَآهُ بِالْأُفُقِ الْمُبِينِ"},{"id":5824,"numberInSurah":24,"text_uthmani":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ","text_simple":"وَمَا هُوَ عَلَى الْغَيْبِ بِضَنِينٍ"},{"id":5825,"numberInSurah":25,"text_uthmani":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍ رَّجِيمٍ","text_simple":"وَمَا هُوَ بِقَوْلِ شَيْطَانٍ رَجِيمٍ"},{"id":5826,"numberInSurah":26,"text_uthmani":"فَأَيْنَ تَذْهَبُونَ","text_simple":"فَأَيْنَ تَذْهَبُونَ"},{"id":5827,"numberInSurah":27,"text_uthmani":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ","text_simple":"إِنْ هُوَ إِلَّا ذِكْرٌ لِلْعَالَمِينَ"},{"id":5828,"numberInSurah":28,"text_uthmani":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","text_simple":"لِمَنْ شَاءَ مِنْكُمْ أَنْ يَسْتَقِيمَ"},{"id":5829,"numberInSurah":29,"text_uthmani":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","text_simple":"وَمَا تَشَاءُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ رَبُّ الْعَالَمِينَ"}]}