{"surahId":84,"verses":[{"id":5885,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِذَا السَّمَاءُ انْشَقَّتْ"},{"id":5886,"numberInSurah":2,"text_uthmani":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","text_simple":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"id":5887,"numberInSurah":3,"text_uthmani":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","text_simple":"وَإِذَا الْأَرْضُ مُدَّتْ"},{"id":5888,"numberInSurah":4,"text_uthmani":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","text_simple":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"id":5889,"numberInSurah":5,"text_uthmani":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","text_simple":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"id":5890,"numberInSurah":6,"text_uthmani":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَٰقِيهِ","text_simple":"يَا أَيُّهَا الْإِنْسَانُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَاقِيهِ"},{"id":5891,"numberInSurah":7,"text_uthmani":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ","text_simple":"فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ"},{"id":5892,"numberInSurah":8,"text_uthmani":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا","text_simple":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا"},{"id":5893,"numberInSurah":9,"text_uthmani":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا","text_simple":"وَيَنْقَلِبُ إِلَىٰ أَهْلِهِ مَسْرُورًا"},{"id":5894,"numberInSurah":10,"text_uthmani":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","text_simple":"وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ وَرَاءَ ظَهْرِهِ"},{"id":5895,"numberInSurah":11,"text_uthmani":"فَسَوْفَ يَدْعُوا ثُبُورًا","text_simple":"فَسَوْفَ يَدْعُو ثُبُورًا"},{"id":5896,"numberInSurah":12,"text_uthmani":"وَيَصْلَىٰ سَعِيرًا","text_simple":"وَيَصْلَىٰ سَعِيرًا"},{"id":5897,"numberInSurah":13,"text_uthmani":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","text_simple":"إِنَّهُ كَانَ فِي أَهْلِهِ مَسْرُورًا"},{"id":5898,"numberInSurah":14,"text_uthmani":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","text_simple":"إِنَّهُ ظَنَّ أَنْ لَنْ يَحُورَ"},{"id":5899,"numberInSurah":15,"text_uthmani":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا","text_simple":"بَلَىٰ إِنَّ رَبَّهُ كَانَ بِهِ بَصِيرًا"},{"id":5900,"numberInSurah":16,"text_uthmani":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","text_simple":"فَلَا أُقْسِمُ بِالشَّفَقِ"},{"id":5901,"numberInSurah":17,"text_uthmani":"وَٱلَّيْلِ وَمَا وَسَقَ","text_simple":"وَاللَّيْلِ وَمَا وَسَقَ"},{"id":5902,"numberInSurah":18,"text_uthmani":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ","text_simple":"وَالْقَمَرِ إِذَا اتَّسَقَ"},{"id":5903,"numberInSurah":19,"text_uthmani":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ","text_simple":"لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍ"},{"id":5904,"numberInSurah":20,"text_uthmani":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","text_simple":"فَمَا لَهُمْ لَا يُؤْمِنُونَ"},{"id":5905,"numberInSurah":21,"text_uthmani":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ","text_simple":"وَإِذَا قُرِئَ عَلَيْهِمُ الْقُرْآنُ لَا يَسْجُدُونَ"},{"id":5906,"numberInSurah":22,"text_uthmani":"بَلِ ٱلَّذِينَ كَفَرُوا يُكَذِّبُونَ","text_simple":"بَلِ الَّذِينَ كَفَرُوا يُكَذِّبُونَ"},{"id":5907,"numberInSurah":23,"text_uthmani":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ","text_simple":"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَ"},{"id":5908,"numberInSurah":24,"text_uthmani":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ","text_simple":"فَبَشِّرْهُمْ بِعَذَابٍ أَلِيمٍ"},{"id":5909,"numberInSurah":25,"text_uthmani":"إِلَّا ٱلَّذِينَ ءَامَنُوا وَعَمِلُوا ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ","text_simple":"إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ"}]}