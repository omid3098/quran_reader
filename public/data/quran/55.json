{"surahId":55,"verses":[{"id":4902,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلرَّحْمَٰنُ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الرَّحْمَٰنُ"},{"id":4903,"numberInSurah":2,"text_uthmani":"عَلَّمَ ٱلْقُرْءَانَ","text_simple":"عَلَّمَ الْقُرْآنَ"},{"id":4904,"numberInSurah":3,"text_uthmani":"خَلَقَ ٱلْإِنسَٰنَ","text_simple":"خَلَقَ الْإِنْسَانَ"},{"id":4905,"numberInSurah":4,"text_uthmani":"عَلَّمَهُ ٱلْبَيَانَ","text_simple":"عَلَّمَهُ الْبَيَانَ"},{"id":4906,"numberInSurah":5,"text_uthmani":"ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ","text_simple":"الشَّمْسُ وَالْقَمَرُ بِحُسْبَانٍ"},{"id":4907,"numberInSurah":6,"text_uthmani":"وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ","text_simple":"وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَانِ"},{"id":4908,"numberInSurah":7,"text_uthmani":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ","text_simple":"وَالسَّمَاءَ رَفَعَهَا وَوَضَعَ الْمِيزَانَ"},{"id":4909,"numberInSurah":8,"text_uthmani":"أَلَّا تَطْغَوْا فِى ٱلْمِيزَانِ","text_simple":"أَلَّا تَطْغَوْا فِي الْمِيزَانِ"},{"id":4910,"numberInSurah":9,"text_uthmani":"وَأَقِيمُوا ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا ٱلْمِيزَانَ","text_simple":"وَأَقِيمُوا الْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُوا الْمِيزَانَ"},{"id":4911,"numberInSurah":10,"text_uthmani":"وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ","text_simple":"وَالْأَرْضَ وَضَعَهَا لِلْأَنَامِ"},{"id":4912,"numberInSurah":11,"text_uthmani":"فِيهَا فَٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ","text_simple":"فِيهَا فَاكِهَةٌ وَالنَّخْلُ ذَاتُ الْأَكْمَامِ"},{"id":4913,"numberInSurah":12,"text_uthmani":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ","text_simple":"وَالْحَبُّ ذُو الْعَصْفِ وَالرَّيْحَانُ"},{"id":4914,"numberInSurah":13,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4915,"numberInSurah":14,"text_uthmani":"خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍ كَٱلْفَخَّارِ","text_simple":"خَلَقَ الْإِنْسَانَ مِنْ صَلْصَالٍ كَالْفَخَّارِ"},{"id":4916,"numberInSurah":15,"text_uthmani":"وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ","text_simple":"وَخَلَقَ الْجَانَّ مِنْ مَارِجٍ مِنْ نَارٍ"},{"id":4917,"numberInSurah":16,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4918,"numberInSurah":17,"text_uthmani":"رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ","text_simple":"رَبُّ الْمَشْرِقَيْنِ وَرَبُّ الْمَغْرِبَيْنِ"},{"id":4919,"numberInSurah":18,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4920,"numberInSurah":19,"text_uthmani":"مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ","text_simple":"مَرَجَ الْبَحْرَيْنِ يَلْتَقِيَانِ"},{"id":4921,"numberInSurah":20,"text_uthmani":"بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيَانِ","text_simple":"بَيْنَهُمَا بَرْزَخٌ لَا يَبْغِيَانِ"},{"id":4922,"numberInSurah":21,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4923,"numberInSurah":22,"text_uthmani":"يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ","text_simple":"يَخْرُجُ مِنْهُمَا اللُّؤْلُؤُ وَالْمَرْجَانُ"},{"id":4924,"numberInSurah":23,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4925,"numberInSurah":24,"text_uthmani":"وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ","text_simple":"وَلَهُ الْجَوَارِ الْمُنْشَآتُ فِي الْبَحْرِ كَالْأَعْلَامِ"},{"id":4926,"numberInSurah":25,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4927,"numberInSurah":26,"text_uthmani":"كُلُّ مَنْ عَلَيْهَا فَانٍ","text_simple":"كُلُّ مَنْ عَلَيْهَا فَانٍ"},{"id":4928,"numberInSurah":27,"text_uthmani":"وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ","text_simple":"وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو الْجَلَالِ وَالْإِكْرَامِ"},{"id":4929,"numberInSurah":28,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4930,"numberInSurah":29,"text_uthmani":"يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ","text_simple":"يَسْأَلُهُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ كُلَّ يَوْمٍ هُوَ فِي شَأْنٍ"},{"id":4931,"numberInSurah":30,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4932,"numberInSurah":31,"text_uthmani":"سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ","text_simple":"سَنَفْرُغُ لَكُمْ أَيُّهَ الثَّقَلَانِ"},{"id":4933,"numberInSurah":32,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4934,"numberInSurah":33,"text_uthmani":"يَٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا مِنْ أَقْطَارِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٍ","text_simple":"يَا مَعْشَرَ الْجِنِّ وَالْإِنْسِ إِنِ اسْتَطَعْتُمْ أَنْ تَنْفُذُوا مِنْ أَقْطَارِ السَّمَاوَاتِ وَالْأَرْضِ فَانْفُذُوا لَا تَنْفُذُونَ إِلَّا بِسُلْطَانٍ"},{"id":4935,"numberInSurah":34,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4936,"numberInSurah":35,"text_uthmani":"يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ","text_simple":"يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِنْ نَارٍ وَنُحَاسٌ فَلَا تَنْتَصِرَانِ"},{"id":4937,"numberInSurah":36,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4938,"numberInSurah":37,"text_uthmani":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ","text_simple":"فَإِذَا انْشَقَّتِ السَّمَاءُ فَكَانَتْ وَرْدَةً كَالدِّهَانِ"},{"id":4939,"numberInSurah":38,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4940,"numberInSurah":39,"text_uthmani":"فَيَوْمَئِذٍ لَّا يُسْـَٔلُ عَن ذَنبِهِۦٓ إِنسٌ وَلَا جَآنٌّ","text_simple":"فَيَوْمَئِذٍ لَا يُسْأَلُ عَنْ ذَنْبِهِ إِنْسٌ وَلَا جَانٌّ"},{"id":4941,"numberInSurah":40,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4942,"numberInSurah":41,"text_uthmani":"يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ","text_simple":"يُعْرَفُ الْمُجْرِمُونَ بِسِيمَاهُمْ فَيُؤْخَذُ بِالنَّوَاصِي وَالْأَقْدَامِ"},{"id":4943,"numberInSurah":42,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4944,"numberInSurah":43,"text_uthmani":"هَٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ","text_simple":"هَٰذِهِ جَهَنَّمُ الَّتِي يُكَذِّبُ بِهَا الْمُجْرِمُونَ"},{"id":4945,"numberInSurah":44,"text_uthmani":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍ","text_simple":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ آنٍ"},{"id":4946,"numberInSurah":45,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4947,"numberInSurah":46,"text_uthmani":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ","text_simple":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِ جَنَّتَانِ"},{"id":4948,"numberInSurah":47,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4949,"numberInSurah":48,"text_uthmani":"ذَوَاتَآ أَفْنَانٍ","text_simple":"ذَوَاتَا أَفْنَانٍ"},{"id":4950,"numberInSurah":49,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4951,"numberInSurah":50,"text_uthmani":"فِيهِمَا عَيْنَانِ تَجْرِيَانِ","text_simple":"فِيهِمَا عَيْنَانِ تَجْرِيَانِ"},{"id":4952,"numberInSurah":51,"text_uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","text_simple":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},{"id":4953,"numberInSurah":52,"text_