{"surahId":92,"verses":[{"id":6059,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَاللَّيْلِ إِذَا يَغْشَىٰ"},{"id":6060,"numberInSurah":2,"text_uthmani":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","text_simple":"وَالنَّهَارِ إِذَا تَجَلَّىٰ"},{"id":6061,"numberInSurah":3,"text_uthmani":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","text_simple":"وَمَا خَلَقَ الذَّكَرَ وَالْأُنْثَىٰ"},{"id":6062,"numberInSurah":4,"text_uthmani":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","text_simple":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ"},{"id":6063,"numberInSurah":5,"text_uthmani":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","text_simple":"فَأَمَّا مَنْ أَعْطَىٰ وَاتَّقَىٰ"},{"id":6064,"numberInSurah":6,"text_uthmani":"وَصَدَّقَ بِٱلْحُسْنَىٰ","text_simple":"وَصَدَّقَ بِالْحُسْنَىٰ"},{"id":6065,"numberInSurah":7,"text_uthmani":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","text_simple":"فَسَنُيَسِّرُهُ لِلْيُسْرَىٰ"},{"id":6066,"numberInSurah":8,"text_uthmani":"وَأَمَّا مَن بَخِلَ وَٱسْتَغْنَىٰ","text_simple":"وَأَمَّا مَنْ بَخِلَ وَاسْتَغْنَىٰ"},{"id":6067,"numberInSurah":9,"text_uthmani":"وَكَذَّبَ بِٱلْحُسْنَىٰ","text_simple":"وَكَذَّبَ بِالْحُسْنَىٰ"},{"id":6068,"numberInSurah":10,"text_uthmani":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","text_simple":"فَسَنُيَسِّرُهُ لِلْعُسْرَىٰ"},{"id":6069,"numberInSurah":11,"text_uthmani":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","text_simple":"وَمَا يُغْنِي عَنْهُ مَالُهُ إِذَا تَرَدَّىٰ"},{"id":6070,"numberInSurah":12,"text_uthmani":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","text_simple":"إِنَّ عَلَيْنَا لَلْهُدَىٰ"},{"id":6071,"numberInSurah":13,"text_uthmani":"وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ","text_simple":"وَإِنَّ لَنَا لَلْآخِرَةَ وَالْأُولَىٰ"},{"id":6072,"numberInSurah":14,"text_uthmani":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ","text_simple":"فَأَنْذَرْتُكُمْ نَارًا تَلَظَّىٰ"},{"id":6073,"numberInSurah":15,"text_uthmani":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","text_simple":"لَا يَصْلَاهَا إِلَّا الْأَشْقَى"},{"id":6074,"numberInSurah":16,"text_uthmani":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","text_simple":"الَّذِي كَذَّبَ وَتَوَلَّىٰ"},{"id":6075,"numberInSurah":17,"text_uthmani":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","text_simple":"وَسَيُجَنَّبُهَا الْأَتْقَى"},{"id":6076,"numberInSurah":18,"text_uthmani":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","text_simple":"الَّذِي يُؤْتِي مَالَهُ يَتَزَكَّىٰ"},{"id":6077,"numberInSurah":19,"text_uthmani":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ","text_simple":"وَمَا لِأَحَدٍ عِنْدَهُ مِنْ نِعْمَةٍ تُجْزَىٰ"},{"id":6078,"numberInSurah":20,"text_uthmani":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","text_simple":"إِلَّا ابْتِغَاءَ وَجْهِ رَبِّهِ الْأَعْلَىٰ"},{"id":6079,"numberInSurah":21,"text_uthmani":"وَلَسَوْفَ يَرْضَىٰ","text_simple":"وَلَسَوْفَ يَرْضَىٰ"}]}