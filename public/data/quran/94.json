{"surahId":94,"verses":[{"id":6091,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ"},{"id":6092,"numberInSurah":2,"text_uthmani":"وَوَضَعْنَا عَنكَ وِزْرَكَ","text_simple":"وَوَضَعْنَا عَنْكَ وِزْرَكَ"},{"id":6093,"numberInSurah":3,"text_uthmani":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","text_simple":"الَّذِي أَنْقَضَ ظَهْرَكَ"},{"id":6094,"numberInSurah":4,"text_uthmani":"وَرَفَعْنَا لَكَ ذِكْرَكَ","text_simple":"وَرَفَعْنَا لَكَ ذِكْرَكَ"},{"id":6095,"numberInSurah":5,"text_uthmani":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","text_simple":"فَإِنَّ مَعَ الْعُسْرِ يُسْرًا"},{"id":6096,"numberInSurah":6,"text_uthmani":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","text_simple":"إِنَّ مَعَ الْعُسْرِ يُسْرًا"},{"id":6097,"numberInSurah":7,"text_uthmani":"فَإِذَا فَرَغْتَ فَٱنصَبْ","text_simple":"فَإِذَا فَرَغْتَ فَانْصَبْ"},{"id":6098,"numberInSurah":8,"text_uthmani":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","text_simple":"وَإِلَىٰ رَبِّكَ فَارْغَبْ"}]}