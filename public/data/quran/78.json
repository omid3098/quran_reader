{"surahId":78,"verses":[{"id":5673,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ عَمَّ يَتَسَاءَلُونَ"},{"id":5674,"numberInSurah":2,"text_uthmani":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ","text_simple":"عَنِ النَّبَإِ الْعَظِيمِ"},{"id":5675,"numberInSurah":3,"text_uthmani":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ","text_simple":"الَّذِي هُمْ فِيهِ مُخْتَلِفُونَ"},{"id":5676,"numberInSurah":4,"text_uthmani":"كَلَّا سَيَعْلَمُونَ","text_simple":"كَلَّا سَيَعْلَمُونَ"},{"id":5677,"numberInSurah":5,"text_uthmani":"ثُمَّ كَلَّا سَيَعْلَمُونَ","text_simple":"ثُمَّ كَلَّا سَيَعْلَمُونَ"},{"id":5678,"numberInSurah":6,"text_uthmani":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًا","text_simple":"أَلَمْ نَجْعَلِ الْأَرْضَ مِهَادًا"},{"id":5679,"numberInSurah":7,"text_uthmani":"وَٱلْجِبَالَ أَوْتَادًا","text_simple":"وَالْجِبَالَ أَوْتَادًا"},{"id":5680,"numberInSurah":8,"text_uthmani":"وَخَلَقْنَٰكُمْ أَزْوَٰجًا","text_simple":"وَخَلَقْنَاكُمْ أَزْوَاجًا"},{"id":5681,"numberInSurah":9,"text_uthmani":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا","text_simple":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا"},{"id":5682,"numberInSurah":10,"text_uthmani":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا","text_simple":"وَجَعَلْنَا اللَّيْلَ لِبَاسًا"},{"id":5683,"numberInSurah":11,"text_uthmani":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا","text_simple":"وَجَعَلْنَا النَّهَارَ مَعَاشًا"},{"id":5684,"numberInSurah":12,"text_uthmani":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا","text_simple":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا"},{"id":5685,"numberInSurah":13,"text_uthmani":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا","text_simple":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا"},{"id":5686,"numberInSurah":14,"text_uthmani":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا","text_simple":"وَأَنْزَلْنَا مِنَ الْمُعْصِرَاتِ مَاءً ثَجَّاجًا"},{"id":5687,"numberInSurah":15,"text_uthmani":"لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا","text_simple":"لِنُخْرِجَ بِهِ حَبًّا وَنَبَاتًا"},{"id":5688,"numberInSurah":16,"text_uthmani":"وَجَنَّٰتٍ أَلْفَافًا","text_simple":"وَجَنَّاتٍ أَلْفَافًا"},{"id":5689,"numberInSurah":17,"text_uthmani":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًا","text_simple":"إِنَّ يَوْمَ الْفَصْلِ كَانَ مِيقَاتًا"},{"id":5690,"numberInSurah":18,"text_uthmani":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا","text_simple":"يَوْمَ يُنْفَخُ فِي الصُّورِ فَتَأْتُونَ أَفْوَاجًا"},{"id":5691,"numberInSurah":19,"text_uthmani":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا","text_simple":"وَفُتِحَتِ السَّمَاءُ فَكَانَتْ أَبْوَابًا"},{"id":5692,"numberInSurah":20,"text_uthmani":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","text_simple":"وَسُيِّرَتِ الْجِبَالُ فَكَانَتْ سَرَابًا"},{"id":5693,"numberInSurah":21,"text_uthmani":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا","text_simple":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا"},{"id":5694,"numberInSurah":22,"text_uthmani":"لِّلطَّٰغِينَ مَـَٔابًا","text_simple":"لِلطَّاغِينَ مَآبًا"},{"id":5695,"numberInSurah":23,"text_uthmani":"لَّٰبِثِينَ فِيهَآ أَحْقَابًا","text_simple":"لَابِثِينَ فِيهَا أَحْقَابًا"},{"id":5696,"numberInSurah":24,"text_uthmani":"لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا","text_simple":"لَا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا"},{"id":5697,"numberInSurah":25,"text_uthmani":"إِلَّا حَمِيمًا وَغَسَّاقًا","text_simple":"إِلَّا حَمِيمًا وَغَسَّاقًا"},{"id":5698,"numberInSurah":26,"text_uthmani":"جَزَآءً وِفَاقًا","text_simple":"جَزَاءً وِفَاقًا"},{"id":5699,"numberInSurah":27,"text_uthmani":"إِنَّهُمْ كَانُوا لَا يَرْجُونَ حِسَابًا","text_simple":"إِنَّهُمْ كَانُوا لَا يَرْجُونَ حِسَابًا"},{"id":5700,"numberInSurah":28,"text_uthmani":"وَكَذَّبُوا بِـَٔايَٰتِنَا كِذَّابًا","text_simple":"وَكَذَّبُوا بِآيَاتِنَا كِذَّابًا"},{"id":5701,"numberInSurah":29,"text_uthmani":"وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًا","text_simple":"وَكُلَّ شَيْءٍ أَحْصَيْنَاهُ كِتَابًا"},{"id":5702,"numberInSurah":30,"text_uthmani":"فَذُوقُوا فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا","text_simple":"فَذُوقُوا فَلَنْ نَزِيدَكُمْ إِلَّا عَذَابًا"},{"id":5703,"numberInSurah":31,"text_uthmani":"إِنَّ لِلْمُتَّقِينَ مَفَازًا","text_simple":"إِنَّ لِلْمُتَّقِينَ مَفَازًا"},{"id":5704,"numberInSurah":32,"text_uthmani":"حَدَآئِقَ وَأَعْنَٰبًا","text_simple":"حَدَائِقَ وَأَعْنَابًا"},{"id":5705,"numberInSurah":33,"text_uthmani":"وَكَوَاعِبَ أَتْرَابًا","text_simple":"وَكَوَاعِبَ أَتْرَابًا"},{"id":5706,"numberInSurah":34,"text_uthmani":"وَكَأْسًا دِهَاقًا","text_simple":"وَكَأْسًا دِهَاقًا"},{"id":5707,"numberInSurah":35,"text_uthmani":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا","text_simple":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّابًا"},{"id":5708,"numberInSurah":36,"text_uthmani":"جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا","text_simple":"جَزَاءً مِنْ رَبِّكَ عَطَاءً حِسَابًا"},{"id":5709,"numberInSurah":37,"text_uthmani":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًا","text_simple":"رَبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا الرَّحْمَٰنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًا"},{"id":5710,"numberInSurah":38,"text_uthmani":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّا لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًا","text_simple":"يَوْمَ يَقُومُ الرُّوحُ وَالْمَلَائِكَةُ صَفًّا لَا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ الرَّحْمَٰنُ وَقَالَ صَوَابًا"},{"id":5711,"numberInSurah":39,"text_uthmani":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","text_simple":"ذَٰلِكَ الْيَوْمُ الْحَقُّ فَمَنْ شَاءَ اتَّخَذَ إِلَىٰ رَبِّهِ مَآبًا"},{"id":5712,"numberInSurah":40,"text_uthmani":"إِنَّآ أَنذَرْنَٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًا","text_simple":"إِنَّا أَنْذَرْنَاكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنْظُرُ الْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ الْكَافِرُ يَا لَيْتَنِي كُنْتُ تُرَابًا"}]}