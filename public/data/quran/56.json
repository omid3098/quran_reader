{"surahId":56,"verses":[{"id":4980,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِذَا وَقَعَتِ الْوَاقِعَةُ"},{"id":4981,"numberInSurah":2,"text_uthmani":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ","text_simple":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ"},{"id":4982,"numberInSurah":3,"text_uthmani":"خَافِضَةٌ رَّافِعَةٌ","text_simple":"خَافِضَةٌ رَافِعَةٌ"},{"id":4983,"numberInSurah":4,"text_uthmani":"إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا","text_simple":"إِذَا رُجَّتِ الْأَرْضُ رَجًّا"},{"id":4984,"numberInSurah":5,"text_uthmani":"وَبُسَّتِ ٱلْجِبَالُ بَسًّا","text_simple":"وَبُسَّتِ الْجِبَالُ بَسًّا"},{"id":4985,"numberInSurah":6,"text_uthmani":"فَكَانَتْ هَبَآءً مُّنبَثًّا","text_simple":"فَكَانَتْ هَبَاءً مُنْبَثًّا"},{"id":4986,"numberInSurah":7,"text_uthmani":"وَكُنتُمْ أَزْوَٰجًا ثَلَٰثَةً","text_simple":"وَكُنْتُمْ أَزْوَاجًا ثَلَاثَةً"},{"id":4987,"numberInSurah":8,"text_uthmani":"فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ","text_simple":"فَأَصْحَابُ الْمَيْمَنَةِ مَا أَصْحَابُ الْمَيْمَنَةِ"},{"id":4988,"numberInSurah":9,"text_uthmani":"وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","text_simple":"وَأَصْحَابُ الْمَشْأَمَةِ مَا أَصْحَابُ الْمَشْأَمَةِ"},{"id":4989,"numberInSurah":10,"text_uthmani":"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ","text_simple":"وَالسَّابِقُونَ السَّابِقُونَ"},{"id":4990,"numberInSurah":11,"text_uthmani":"أُولَٰٓئِكَ ٱلْمُقَرَّبُونَ","text_simple":"أُولَٰئِكَ الْمُقَرَّبُونَ"},{"id":4991,"numberInSurah":12,"text_uthmani":"فِى جَنَّٰتِ ٱلنَّعِيمِ","text_simple":"فِي جَنَّاتِ النَّعِيمِ"},{"id":4992,"numberInSurah":13,"text_uthmani":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ","text_simple":"ثُلَّةٌ مِنَ الْأَوَّلِينَ"},{"id":4993,"numberInSurah":14,"text_uthmani":"وَقَلِيلٌ مِّنَ ٱلْءَاخِرِينَ","text_simple":"وَقَلِيلٌ مِنَ الْآخِرِينَ"},{"id":4994,"numberInSurah":15,"text_uthmani":"عَلَىٰ سُرُرٍ مَّوْضُونَةٍ","text_simple":"عَلَىٰ سُرُرٍ مَوْضُونَةٍ"},{"id":4995,"numberInSurah":16,"text_uthmani":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ","text_simple":"مُتَّكِئِينَ عَلَيْهَا مُتَقَابِلِينَ"},{"id":4996,"numberInSurah":17,"text_uthmani":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ","text_simple":"يَطُوفُ عَلَيْهِمْ وِلْدَانٌ مُخَلَّدُونَ"},{"id":4997,"numberInSurah":18,"text_uthmani":"بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ","text_simple":"بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِنْ مَعِينٍ"},{"id":4998,"numberInSurah":19,"text_uthmani":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ","text_simple":"لَا يُصَدَّعُونَ عَنْهَا وَلَا يُنْزِفُونَ"},{"id":4999,"numberInSurah":20,"text_uthmani":"وَفَٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ","text_simple":"وَفَاكِهَةٍ مِمَّا يَتَخَيَّرُونَ"},{"id":5000,"numberInSurah":21,"text_uthmani":"وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ","text_simple":"وَلَحْمِ طَيْرٍ مِمَّا يَشْتَهُونَ"},{"id":5001,"numberInSurah":22,"text_uthmani":"وَحُورٌ عِينٌ","text_simple":"وَحُورٌ عِينٌ"},{"id":5002,"numberInSurah":23,"text_uthmani":"كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ","text_simple":"كَأَمْثَالِ اللُّؤْلُؤِ الْمَكْنُونِ"},{"id":5003,"numberInSurah":24,"text_uthmani":"جَزَآءً بِمَا كَانُوا يَعْمَلُونَ","text_simple":"جَزَاءً بِمَا كَانُوا يَعْمَلُونَ"},{"id":5004,"numberInSurah":25,"text_uthmani":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا","text_simple":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا"},{"id":5005,"numberInSurah":26,"text_uthmani":"إِلَّا قِيلًا سَلَٰمًا سَلَٰمًا","text_simple":"إِلَّا قِيلًا سَلَامًا سَلَامًا"},{"id":5006,"numberInSurah":27,"text_uthmani":"وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ","text_simple":"وَأَصْحَابُ الْيَمِينِ مَا أَصْحَابُ الْيَمِينِ"},{"id":5007,"numberInSurah":28,"text_uthmani":"فِى سِدْرٍ مَّخْضُودٍ","text_simple":"فِي سِدْرٍ مَخْضُودٍ"},{"id":5008,"numberInSurah":29,"text_uthmani":"وَطَلْحٍ مَّنضُودٍ","text_simple":"وَطَلْحٍ مَنْضُودٍ"},{"id":5009,"numberInSurah":30,"text_uthmani":"وَظِلٍّ مَّمْدُودٍ","text_simple":"وَظِلٍّ مَمْدُودٍ"},{"id":5010,"numberInSurah":31,"text_uthmani":"وَمَآءٍ مَّسْكُوبٍ","text_simple":"وَمَاءٍ مَسْكُوبٍ"},{"id":5011,"numberInSurah":32,"text_uthmani":"وَفَٰكِهَةٍ كَثِيرَةٍ","text_simple":"وَفَاكِهَةٍ كَثِيرَةٍ"},{"id":5012,"numberInSurah":33,"text_uthmani":"لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ","text_simple":"لَا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ"},{"id":5013,"numberInSurah":34,"text_uthmani":"وَفُرُشٍ مَّرْفُوعَةٍ","text_simple":"وَفُرُشٍ مَرْفُوعَةٍ"},{"id":5014,"numberInSurah":35,"text_uthmani":"إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءً","text_simple":"إِنَّا أَنْشَأْنَاهُنَّ إِنْشَاءً"},{"id":5015,"numberInSurah":36,"text_uthmani":"فَجَعَلْنَٰهُنَّ أَبْكَارًا","text_simple":"فَجَعَلْنَاهُنَّ أَبْكَارًا"},{"id":5016,"numberInSurah":37,"text_uthmani":"عُرُبًا أَتْرَابًا","text_simple":"عُرُبًا أَتْرَابًا"},{"id":5017,"numberInSurah":38,"text_uthmani":"لِّأَصْحَٰبِ ٱلْيَمِينِ","text_simple":"لِأَصْحَابِ الْيَمِينِ"},{"id":5018,"numberInSurah":39,"text_uthmani":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ","text_simple":"ثُلَّةٌ مِنَ الْأَوَّلِينَ"},{"id":5019,"numberInSurah":40,"text_uthmani":"وَثُلَّةٌ مِّنَ ٱلْءَاخِرِينَ","text_simple":"وَثُلَّةٌ مِنَ الْآخِرِينَ"},{"id":5020,"numberInSurah":41,"text_uthmani":"وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ","text_simple":"وَأَصْحَابُ الشِّمَالِ مَا أَصْحَابُ الشِّمَالِ"},{"id":5021,"numberInSurah":42,"text_uthmani":"فِى سَمُومٍ وَحَمِيمٍ","text_simple":"فِي سَمُومٍ وَحَمِيمٍ"},{"id":5022,"numberInSurah":43,"text_uthmani":"وَظِلٍّ مِّن يَحْمُومٍ","text_simple":"وَظِلٍّ مِنْ يَحْمُومٍ"},{"id":5023,"numberInSurah":44,"text_uthmani":"لَّا بَارِدٍ وَلَا كَرِيمٍ","text_simple":"لَا بَارِدٍ وَلَا كَرِيمٍ"},{"id":5024,"numberInSurah":45,"text_uthmani":"إِنَّهُمْ كَانُوا قَبْلَ ذَٰلِكَ مُتْرَفِينَ","text_simple":"إِنَّهُمْ كَانُوا قَبْلَ ذَٰلِكَ مُتْرَفِينَ"},{"id":5025,"numberInSurah":46,"text_uthmani":"وَكَانُوا يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ","text_simple":"وَكَانُوا يُصِرُّونَ عَلَى الْحِنْثِ الْعَظِيمِ"},{"id":5026,"numberInSurah":47,"text_uthmani":"وَكَانُوا يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ","text_simple":"وَكَانُوا يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَبْعُوثُونَ"},{"id":5027,"numberInSurah":48,"text_uthmani":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","text_simple":"أَوَآبَاؤُنَا الْأَوَّلُونَ"},{"id":5028,"numberInSurah":49,"text_uthmani":"قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْءَاخِرِينَ","text_simple":"قُلْ إِنَّ الْأَوَّلِينَ وَالْآخِرِينَ"},{"id":5029,"numberInSurah":50,"text_uthmani":"لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍ مَّعْلُومٍ","text_simple":"لَمَجْمُوعُونَ إِلَىٰ مِيقَاتِ يَوْمٍ مَعْلُومٍ"},{"id":5030,"numberInSurah":51,"text_uthmani":"ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ","text_simple":"ثُمَّ إِنَّكُمْ أَيُّهَا الضَّالُّونَ الْمُكَذِّبُونَ"},{"id":5031,"numberInSurah":52,"text_uthmani":"لَءَاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ","text_simple":"لَآكِلُونَ مِنْ شَجَرٍ مِنْ زَقُّومٍ"},{"id":5032,"numberInSurah":53,"text_uthmani":"فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","text_simple":"فَمَالِئُونَ مِنْهَا الْبُطُونَ"},{"id":5033,"numberInSurah":54,"text_uthmani":"فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ","text_simple":"فَشَارِبُونَ عَلَيْهِ مِنَ الْحَمِيمِ"},{"id":5034,"numberInSurah":55,"text_uthmani":"فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ","text_simple":"فَشَارِبُونَ شُرْبَ الْهِيمِ"},{"id":5035,"numberInSurah":56,"text_uthmani":"هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ","text_simple":"هَٰذَا نُزُلُهُمْ يَوْمَ الدِّينِ"},{"id":5036,"numberInSurah":57,"text_uthmani":"نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ","text_simple":"نَحْنُ خَلَقْنَاكُمْ فَلَوْلَا تُصَدِّقُونَ"},{"id":5037,"numberInSurah":58,"text_uthmani":"أَفَرَءَيْتُم مَّا تُمْنُونَ","text_simple":"أَفَرَأَيْتُمْ مَا تُمْنُونَ"},{"id":5038,"numberInSurah":59,"text_uthmani":"ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ","text_simple":"أَأَنْتُمْ تَخْلُقُونَهُ أَمْ نَحْنُ الْخَالِقُونَ"},{"id":5039,"numberInSurah":60,"text_uthmani":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ","text_simple":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ الْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ"},{"id":5040,"numberInSurah":61,"text_uthmani":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ","text_simple":"عَلَىٰ أَنْ نُبَدِّلَ أَمْثَالَكُمْ وَنُنْشِئَكُمْ فِي مَا لَا تَعْلَمُونَ"},{"id":5041,"numberInSurah":62,"text_uthmani":"وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ","text_simple":"وَلَقَدْ عَلِمْتُمُ النَّشْأَةَ الْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ"},{"id":5042,"numberInSurah":63,"text_uthmani":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ","text_simple":"أَفَرَأَيْتُمْ مَا تَحْرُثُونَ"},{"id":5043,"numberInSurah":64,"text_uthmani":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ","text_simple":"أَأَنْتُمْ تَزْرَعُونَهُ أَمْ نَحْنُ الزَّارِعُونَ"},{"id":5044,"numberInSurah":65,"text_uthmani":"لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًا فَظَلْتُمْ تَفَكَّهُونَ","text_simple":"لَوْ نَشَاءُ لَجَعَلْنَاهُ حُطَامًا فَظَلْتُمْ تَفَكَّهُونَ"},{"id":5045,"numberInSurah":66,"text_uthmani":"إِنَّا لَمُغْرَمُونَ","text_simple":"إِنَّا لَمُغْرَمُونَ"},{"id":5046,"numberInSurah":67,"text_uthmani":"بَلْ نَحْنُ مَحْرُومُونَ","text_simple":"بَلْ نَحْنُ مَحْرُومُونَ"},{"id":5047,"numberInSurah":68,"text_uthmani":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ","text_simple":"أَفَرَأَيْتُمُ الْمَاءَ الَّذِي تَشْرَبُونَ"},{"id":5048,"numberInSurah":69,"text_uthmani":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ","text_simple":"أَأَنْتُمْ أَنْزَلْتُمُوهُ مِنَ الْمُزْنِ أَمْ نَحْنُ الْمُنْزِلُونَ"},{"id":5049,"numberInSurah":70,"text_uthmani":"لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ","text_simple":"لَوْ نَشَاءُ جَعَلْنَاهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ"},{"id":5050,"numberInSurah":71,"text_uthmani":"أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ","text_simple":"أَفَرَأَيْتُمُ النَّارَ الَّتِي تُورُونَ"},{"id":5051,"numberInSurah":72,"text_uthmani":"ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ","text_si