{"surahId":75,"verses":[{"id":5552,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ لَا أُقْسِمُ بِيَوْمِ الْقِيَامَةِ"},{"id":5553,"numberInSurah":2,"text_uthmani":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","text_simple":"وَلَا أُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ"},{"id":5554,"numberInSurah":3,"text_uthmani":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","text_simple":"أَيَحْسَبُ الْإِنْسَانُ أَلَّنْ نَجْمَعَ عِظَامَهُ"},{"id":5555,"numberInSurah":4,"text_uthmani":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","text_simple":"بَلَىٰ قَادِرِينَ عَلَىٰ أَنْ نُسَوِّيَ بَنَانَهُ"},{"id":5556,"numberInSurah":5,"text_uthmani":"بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ","text_simple":"بَلْ يُرِيدُ الْإِنْسَانُ لِيَفْجُرَ أَمَامَهُ"},{"id":5557,"numberInSurah":6,"text_uthmani":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ","text_simple":"يَسْأَلُ أَيَّانَ يَوْمُ الْقِيَامَةِ"},{"id":5558,"numberInSurah":7,"text_uthmani":"فَإِذَا بَرِقَ ٱلْبَصَرُ","text_simple":"فَإِذَا بَرِقَ الْبَصَرُ"},{"id":5559,"numberInSurah":8,"text_uthmani":"وَخَسَفَ ٱلْقَمَرُ","text_simple":"وَخَسَفَ الْقَمَرُ"},{"id":5560,"numberInSurah":9,"text_uthmani":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","text_simple":"وَجُمِعَ الشَّمْسُ وَالْقَمَرُ"},{"id":5561,"numberInSurah":10,"text_uthmani":"يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","text_simple":"يَقُولُ الْإِنْسَانُ يَوْمَئِذٍ أَيْنَ الْمَفَرُّ"},{"id":5562,"numberInSurah":11,"text_uthmani":"كَلَّا لَا وَزَرَ","text_simple":"كَلَّا لَا وَزَرَ"},{"id":5563,"numberInSurah":12,"text_uthmani":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","text_simple":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ الْمُسْتَقَرُّ"},{"id":5564,"numberInSurah":13,"text_uthmani":"يُنَبَّؤُا ٱلْإِنسَٰنُ يَوْمَئِذٍ بِمَا قَدَّمَ وَأَخَّرَ","text_simple":"يُنَبَّأُ الْإِنْسَانُ يَوْمَئِذٍ بِمَا قَدَّمَ وَأَخَّرَ"},{"id":5565,"numberInSurah":14,"text_uthmani":"بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ","text_simple":"بَلِ الْإِنْسَانُ عَلَىٰ نَفْسِهِ بَصِيرَةٌ"},{"id":5566,"numberInSurah":15,"text_uthmani":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","text_simple":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُ"},{"id":5567,"numberInSurah":16,"text_uthmani":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","text_simple":"لَا تُحَرِّكْ بِهِ لِسَانَكَ لِتَعْجَلَ بِهِ"},{"id":5568,"numberInSurah":17,"text_uthmani":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","text_simple":"إِنَّ عَلَيْنَا جَمْعَهُ وَقُرْآنَهُ"},{"id":5569,"numberInSurah":18,"text_uthmani":"فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","text_simple":"فَإِذَا قَرَأْنَاهُ فَاتَّبِعْ قُرْآنَهُ"},{"id":5570,"numberInSurah":19,"text_uthmani":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","text_simple":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُ"},{"id":5571,"numberInSurah":20,"text_uthmani":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","text_simple":"كَلَّا بَلْ تُحِبُّونَ الْعَاجِلَةَ"},{"id":5572,"numberInSurah":21,"text_uthmani":"وَتَذَرُونَ ٱلْءَاخِرَةَ","text_simple":"وَتَذَرُونَ الْآخِرَةَ"},{"id":5573,"numberInSurah":22,"text_uthmani":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ","text_simple":"وُجُوهٌ يَوْمَئِذٍ نَاضِرَةٌ"},{"id":5574,"numberInSurah":23,"text_uthmani":"إِلَىٰ رَبِّهَا نَاظِرَةٌ","text_simple":"إِلَىٰ رَبِّهَا نَاظِرَةٌ"},{"id":5575,"numberInSurah":24,"text_uthmani":"وَوُجُوهٌ يَوْمَئِذٍ بَاسِرَةٌ","text_simple":"وَوُجُوهٌ يَوْمَئِذٍ بَاسِرَةٌ"},{"id":5576,"numberInSurah":25,"text_uthmani":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ","text_simple":"تَظُنُّ أَنْ يُفْعَلَ بِهَا فَاقِرَةٌ"},{"id":5577,"numberInSurah":26,"text_uthmani":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","text_simple":"كَلَّا إِذَا بَلَغَتِ التَّرَاقِيَ"},{"id":5578,"numberInSurah":27,"text_uthmani":"وَقِيلَ مَنْ رَاقٍ","text_simple":"وَقِيلَ مَنْ رَاقٍ"},{"id":5579,"numberInSurah":28,"text_uthmani":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","text_simple":"وَظَنَّ أَنَّهُ الْفِرَاقُ"},{"id":5580,"numberInSurah":29,"text_uthmani":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","text_simple":"وَالْتَفَّتِ السَّاقُ بِالسَّاقِ"},{"id":5581,"numberInSurah":30,"text_uthmani":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","text_simple":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ الْمَسَاقُ"},{"id":5582,"numberInSurah":31,"text_uthmani":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","text_simple":"فَلَا صَدَّقَ وَلَا صَلَّىٰ"},{"id":5583,"numberInSurah":32,"text_uthmani":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","text_simple":"وَلَٰكِنْ كَذَّبَ وَتَوَلَّىٰ"},{"id":5584,"numberInSurah":33,"text_uthmani":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","text_simple":"ثُمَّ ذَهَبَ إِلَىٰ أَهْلِهِ يَتَمَطَّىٰ"},{"id":5585,"numberInSurah":34,"text_uthmani":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","text_simple":"أَوْلَىٰ لَكَ فَأَوْلَىٰ"},{"id":5586,"numberInSurah":35,"text_uthmani":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","text_simple":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰ"},{"id":5587,"numberInSurah":36,"text_uthmani":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى","text_simple":"أَيَحْسَبُ الْإِنْسَانُ أَنْ يُتْرَكَ سُدًى"},{"id":5588,"numberInSurah":37,"text_uthmani":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ","text_simple":"أَلَمْ يَكُ نُطْفَةً مِنْ مَنِيٍّ يُمْنَىٰ"},{"id":5589,"numberInSurah":38,"text_uthmani":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ","text_simple":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ"},{"id":5590,"numberInSurah":39,"text_uthmani":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","text_simple":"فَجَعَلَ مِنْهُ الزَّوْجَيْنِ الذَّكَرَ وَالْأُنْثَىٰ"},{"id":5591,"numberInSurah":40,"text_uthmani":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ","text_simple":"أَلَيْسَ ذَٰلِكَ بِقَادِرٍ عَلَىٰ أَنْ يُحْيِيَ الْمَوْتَىٰ"}]}