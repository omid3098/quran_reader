{"surahId":87,"verses":[{"id":5949,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى"},{"id":5950,"numberInSurah":2,"text_uthmani":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","text_simple":"الَّذِي خَلَقَ فَسَوَّىٰ"},{"id":5951,"numberInSurah":3,"text_uthmani":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","text_simple":"وَالَّذِي قَدَّرَ فَهَدَىٰ"},{"id":5952,"numberInSurah":4,"text_uthmani":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","text_simple":"وَالَّذِي أَخْرَجَ الْمَرْعَىٰ"},{"id":5953,"numberInSurah":5,"text_uthmani":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","text_simple":"فَجَعَلَهُ غُثَاءً أَحْوَىٰ"},{"id":5954,"numberInSurah":6,"text_uthmani":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","text_simple":"سَنُقْرِئُكَ فَلَا تَنْسَىٰ"},{"id":5955,"numberInSurah":7,"text_uthmani":"إِلَّا مَا شَآءَ ٱللَّهُ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","text_simple":"إِلَّا مَا شَاءَ اللَّهُ إِنَّهُ يَعْلَمُ الْجَهْرَ وَمَا يَخْفَىٰ"},{"id":5956,"numberInSurah":8,"text_uthmani":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","text_simple":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ"},{"id":5957,"numberInSurah":9,"text_uthmani":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","text_simple":"فَذَكِّرْ إِنْ نَفَعَتِ الذِّكْرَىٰ"},{"id":5958,"numberInSurah":10,"text_uthmani":"سَيَذَّكَّرُ مَن يَخْشَىٰ","text_simple":"سَيَذَّكَّرُ مَنْ يَخْشَىٰ"},{"id":5959,"numberInSurah":11,"text_uthmani":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","text_simple":"وَيَتَجَنَّبُهَا الْأَشْقَى"},{"id":5960,"numberInSurah":12,"text_uthmani":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","text_simple":"الَّذِي يَصْلَى النَّارَ الْكُبْرَىٰ"},{"id":5961,"numberInSurah":13,"text_uthmani":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","text_simple":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"},{"id":5962,"numberInSurah":14,"text_uthmani":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","text_simple":"قَدْ أَفْلَحَ مَنْ تَزَكَّىٰ"},{"id":5963,"numberInSurah":15,"text_uthmani":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","text_simple":"وَذَكَرَ اسْمَ رَبِّهِ فَصَلَّىٰ"},{"id":5964,"numberInSurah":16,"text_uthmani":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","text_simple":"بَلْ تُؤْثِرُونَ الْحَيَاةَ الدُّنْيَا"},{"id":5965,"numberInSurah":17,"text_uthmani":"وَٱلْءَاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ","text_simple":"وَالْآخِرَةُ خَيْرٌ وَأَبْقَىٰ"},{"id":5966,"numberInSurah":18,"text_uthmani":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","text_simple":"إِنَّ هَٰذَا لَفِي الصُّحُفِ الْأُولَىٰ"},{"id":5967,"numberInSurah":19,"text_uthmani":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","text_simple":"صُحُفِ إِبْرَاهِيمَ وَمُوسَىٰ"}]}