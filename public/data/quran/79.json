{"surahId":79,"verses":[{"id":5713,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًا","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالنَّازِعَاتِ غَرْقًا"},{"id":5714,"numberInSurah":2,"text_uthmani":"وَٱلنَّٰشِطَٰتِ نَشْطًا","text_simple":"وَالنَّاشِطَاتِ نَشْطًا"},{"id":5715,"numberInSurah":3,"text_uthmani":"وَٱلسَّٰبِحَٰتِ سَبْحًا","text_simple":"وَالسَّابِحَاتِ سَبْحًا"},{"id":5716,"numberInSurah":4,"text_uthmani":"فَٱلسَّٰبِقَٰتِ سَبْقًا","text_simple":"فَالسَّابِقَاتِ سَبْقًا"},{"id":5717,"numberInSurah":5,"text_uthmani":"فَٱلْمُدَبِّرَٰتِ أَمْرًا","text_simple":"فَالْمُدَبِّرَاتِ أَمْرًا"},{"id":5718,"numberInSurah":6,"text_uthmani":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","text_simple":"يَوْمَ تَرْجُفُ الرَّاجِفَةُ"},{"id":5719,"numberInSurah":7,"text_uthmani":"تَتْبَعُهَا ٱلرَّادِفَةُ","text_simple":"تَتْبَعُهَا الرَّادِفَةُ"},{"id":5720,"numberInSurah":8,"text_uthmani":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ","text_simple":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ"},{"id":5721,"numberInSurah":9,"text_uthmani":"أَبْصَٰرُهَا خَٰشِعَةٌ","text_simple":"أَبْصَارُهَا خَاشِعَةٌ"},{"id":5722,"numberInSurah":10,"text_uthmani":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","text_simple":"يَقُولُونَ أَإِنَّا لَمَرْدُودُونَ فِي الْحَافِرَةِ"},{"id":5723,"numberInSurah":11,"text_uthmani":"أَءِذَا كُنَّا عِظَٰمًا نَّخِرَةً","text_simple":"أَإِذَا كُنَّا عِظَامًا نَخِرَةً"},{"id":5724,"numberInSurah":12,"text_uthmani":"قَالُوا تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ","text_simple":"قَالُوا تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ"},{"id":5725,"numberInSurah":13,"text_uthmani":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ","text_simple":"فَإِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌ"},{"id":5726,"numberInSurah":14,"text_uthmani":"فَإِذَا هُم بِٱلسَّاهِرَةِ","text_simple":"فَإِذَا هُمْ بِالسَّاهِرَةِ"},{"id":5727,"numberInSurah":15,"text_uthmani":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","text_simple":"هَلْ أَتَاكَ حَدِيثُ مُوسَىٰ"},{"id":5728,"numberInSurah":16,"text_uthmani":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","text_simple":"إِذْ نَادَاهُ رَبُّهُ بِالْوَادِ الْمُقَدَّسِ طُوًى"},{"id":5729,"numberInSurah":17,"text_uthmani":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","text_simple":"اذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُ طَغَىٰ"},{"id":5730,"numberInSurah":18,"text_uthmani":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","text_simple":"فَقُلْ هَلْ لَكَ إِلَىٰ أَنْ تَزَكَّىٰ"},{"id":5731,"numberInSurah":19,"text_uthmani":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","text_simple":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ"},{"id":5732,"numberInSurah":20,"text_uthmani":"فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ","text_simple":"فَأَرَاهُ الْآيَةَ الْكُبْرَىٰ"},{"id":5733,"numberInSurah":21,"text_uthmani":"فَكَذَّبَ وَعَصَىٰ","text_simple":"فَكَذَّبَ وَعَصَىٰ"},{"id":5734,"numberInSurah":22,"text_uthmani":"ثُمَّ أَدْبَرَ يَسْعَىٰ","text_simple":"ثُمَّ أَدْبَرَ يَسْعَىٰ"},{"id":5735,"numberInSurah":23,"text_uthmani":"فَحَشَرَ فَنَادَىٰ","text_simple":"فَحَشَرَ فَنَادَىٰ"},{"id":5736,"numberInSurah":24,"text_uthmani":"فَقَالَ أَنَا رَبُّكُمُ ٱلْأَعْلَىٰ","text_simple":"فَقَالَ أَنَا رَبُّكُمُ الْأَعْلَىٰ"},{"id":5737,"numberInSurah":25,"text_uthmani":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ","text_simple":"فَأَخَذَهُ اللَّهُ نَكَالَ الْآخِرَةِ وَالْأُولَىٰ"},{"id":5738,"numberInSurah":26,"text_uthmani":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ","text_simple":"إِنَّ فِي ذَٰلِكَ لَعِبْرَةً لِمَنْ يَخْشَىٰ"},{"id":5739,"numberInSurah":27,"text_uthmani":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ بَنَىٰهَا","text_simple":"أَأَنْتُمْ أَشَدُّ خَلْقًا أَمِ السَّمَاءُ بَنَاهَا"},{"id":5740,"numberInSurah":28,"text_uthmani":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","text_simple":"رَفَعَ سَمْكَهَا فَسَوَّاهَا"},{"id":5741,"numberInSurah":29,"text_uthmani":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","text_simple":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَاهَا"},{"id":5742,"numberInSurah":30,"text_uthmani":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","text_simple":"وَالْأَرْضَ بَعْدَ ذَٰلِكَ دَحَاهَا"},{"id":5743,"numberInSurah":31,"text_uthmani":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","text_simple":"أَخْرَجَ مِنْهَا مَاءَهَا وَمَرْعَاهَا"},{"id":5744,"numberInSurah":32,"text_uthmani":"وَٱلْجِبَالَ أَرْسَىٰهَا","text_simple":"وَالْجِبَالَ أَرْسَاهَا"},{"id":5745,"numberInSurah":33,"text_uthmani":"مَتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ","text_simple":"مَتَاعًا لَكُمْ وَلِأَنْعَامِكُمْ"},{"id":5746,"numberInSurah":34,"text_uthmani":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ","text_simple":"فَإِذَا جَاءَتِ الطَّامَّةُ الْكُبْرَىٰ"},{"id":5747,"numberInSurah":35,"text_uthmani":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ","text_simple":"يَوْمَ يَتَذَكَّرُ الْإِنْسَانُ مَا سَعَىٰ"},{"id":5748,"numberInSurah":36,"text_uthmani":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ","text_simple":"وَبُرِّزَتِ الْجَحِيمُ لِمَنْ يَرَىٰ"},{"id":5749,"numberInSurah":37,"text_uthmani":"فَأَمَّا مَن طَغَىٰ","text_simple":"فَأَمَّا مَنْ طَغَىٰ"},{"id":5750,"numberInSurah":38,"text_uthmani":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","text_simple":"وَآثَرَ الْحَيَاةَ الدُّنْيَا"},{"id":5751,"numberInSurah":39,"text_uthmani":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ","text_simple":"فَإِنَّ الْجَحِيمَ هِيَ الْمَأْوَىٰ"},{"id":5752,"numberInSurah":40,"text_uthmani":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ","text_simple":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِ وَنَهَى النَّفْسَ عَنِ الْهَوَىٰ"},{"id":5753,"numberInSurah":41,"text_uthmani":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","text_simple":"فَإِنَّ الْجَنَّةَ هِيَ الْمَأْوَىٰ"},{"id":5754,"numberInSurah":42,"text_uthmani":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","text_simple":"يَسْأَلُونَكَ عَنِ السَّاعَةِ أَيَّانَ مُرْسَاهَا"},{"id":5755,"numberInSurah":43,"text_uthmani":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","text_simple":"فِيمَ أَنْتَ مِنْ ذِكْرَاهَا"},{"id":5756,"numberInSurah":44,"text_uthmani":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","text_simple":"إِلَىٰ رَبِّكَ مُنْتَهَاهَا"},{"id":5757,"numberInSurah":45,"text_uthmani":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","text_simple":"إِنَّمَا أَنْتَ مُنْذِرُ مَنْ يَخْشَاهَا"},{"id":5758,"numberInSurah":46,"text_uthmani":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","text_simple":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوا إِلَّا عَشِيَّةً أَوْ ضُحَاهَا"}]}