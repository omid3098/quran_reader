{"surahId":37,"verses":[{"id":3789,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلصَّٰٓفَّٰتِ صَفًّا","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالصَّافَّاتِ صَفًّا"},{"id":3790,"numberInSurah":2,"text_uthmani":"فَٱلزَّٰجِرَٰتِ زَجْرًا","text_simple":"فَالزَّاجِرَاتِ زَجْرًا"},{"id":3791,"numberInSurah":3,"text_uthmani":"فَٱلتَّٰلِيَٰتِ ذِكْرًا","text_simple":"فَالتَّالِيَاتِ ذِكْرًا"},{"id":3792,"numberInSurah":4,"text_uthmani":"إِنَّ إِلَٰهَكُمْ لَوَٰحِدٌ","text_simple":"إِنَّ إِلَٰهَكُمْ لَوَاحِدٌ"},{"id":3793,"numberInSurah":5,"text_uthmani":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَٰرِقِ","text_simple":"رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِ"},{"id":3794,"numberInSurah":6,"text_uthmani":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ","text_simple":"إِنَّا زَيَّنَّا السَّمَاءَ الدُّنْيَا بِزِينَةٍ الْكَوَاكِبِ"},{"id":3795,"numberInSurah":7,"text_uthmani":"وَحِفْظًا مِّن كُلِّ شَيْطَٰنٍ مَّارِدٍ","text_simple":"وَحِفْظًا مِنْ كُلِّ شَيْطَانٍ مَارِدٍ"},{"id":3796,"numberInSurah":8,"text_uthmani":"لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ","text_simple":"لَا يَسَّمَّعُونَ إِلَى الْمَلَإِ الْأَعْلَىٰ وَيُقْذَفُونَ مِنْ كُلِّ جَانِبٍ"},{"id":3797,"numberInSurah":9,"text_uthmani":"دُحُورًا وَلَهُمْ عَذَابٌ وَاصِبٌ","text_simple":"دُحُورًا وَلَهُمْ عَذَابٌ وَاصِبٌ"},{"id":3798,"numberInSurah":10,"text_uthmani":"إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ","text_simple":"إِلَّا مَنْ خَطِفَ الْخَطْفَةَ فَأَتْبَعَهُ شِهَابٌ ثَاقِبٌ"},{"id":3799,"numberInSurah":11,"text_uthmani":"فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ إِنَّا خَلَقْنَٰهُم مِّن طِينٍ لَّازِبٍ","text_simple":"فَاسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَمْ مَنْ خَلَقْنَا إِنَّا خَلَقْنَاهُمْ مِنْ طِينٍ لَازِبٍ"},{"id":3800,"numberInSurah":12,"text_uthmani":"بَلْ عَجِبْتَ وَيَسْخَرُونَ","text_simple":"بَلْ عَجِبْتَ وَيَسْخَرُونَ"},{"id":3801,"numberInSurah":13,"text_uthmani":"وَإِذَا ذُكِّرُوا لَا يَذْكُرُونَ","text_simple":"وَإِذَا ذُكِّرُوا لَا يَذْكُرُونَ"},{"id":3802,"numberInSurah":14,"text_uthmani":"وَإِذَا رَأَوْا ءَايَةً يَسْتَسْخِرُونَ","text_simple":"وَإِذَا رَأَوْا آيَةً يَسْتَسْخِرُونَ"},{"id":3803,"numberInSurah":15,"text_uthmani":"وَقَالُوٓا إِنْ هَٰذَآ إِلَّا سِحْرٌ مُّبِينٌ","text_simple":"وَقَالُوا إِنْ هَٰذَا إِلَّا سِحْرٌ مُبِينٌ"},{"id":3804,"numberInSurah":16,"text_uthmani":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ","text_simple":"أَإِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَبْعُوثُونَ"},{"id":3805,"numberInSurah":17,"text_uthmani":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","text_simple":"أَوَآبَاؤُنَا الْأَوَّلُونَ"},{"id":3806,"numberInSurah":18,"text_uthmani":"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ","text_simple":"قُلْ نَعَمْ وَأَنْتُمْ دَاخِرُونَ"},{"id":3807,"numberInSurah":19,"text_uthmani":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ","text_simple":"فَإِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌ فَإِذَا هُمْ يَنْظُرُونَ"},{"id":3808,"numberInSurah":20,"text_uthmani":"وَقَالُوا يَٰوَيْلَنَا هَٰذَا يَوْمُ ٱلدِّينِ","text_simple":"وَقَالُوا يَا وَيْلَنَا هَٰذَا يَوْمُ الدِّينِ"},{"id":3809,"numberInSurah":21,"text_uthmani":"هَٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","text_simple":"هَٰذَا يَوْمُ الْفَصْلِ الَّذِي كُنْتُمْ بِهِ تُكَذِّبُونَ"},{"id":3810,"numberInSurah":22,"text_uthmani":"ٱحْشُرُوا ٱلَّذِينَ ظَلَمُوا وَأَزْوَٰجَهُمْ وَمَا كَانُوا يَعْبُدُونَ","text_simple":"احْشُرُوا الَّذِينَ ظَلَمُوا وَأَزْوَاجَهُمْ وَمَا كَانُوا يَعْبُدُونَ"},{"id":3811,"numberInSurah":23,"text_uthmani":"مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ","text_simple":"مِنْ دُونِ اللَّهِ فَاهْدُوهُمْ إِلَىٰ صِرَاطِ الْجَحِيمِ"},{"id":3812,"numberInSurah":24,"text_uthmani":"وَقِفُوهُمْ إِنَّهُم مَّسْـُٔولُونَ","text_simple":"وَقِفُوهُمْ إِنَّهُمْ مَسْئُولُونَ"},{"id":3813,"numberInSurah":25,"text_uthmani":"مَا لَكُمْ لَا تَنَاصَرُونَ","text_simple":"مَا لَكُمْ لَا تَنَاصَرُونَ"},{"id":3814,"numberInSurah":26,"text_uthmani":"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ","text_simple":"بَلْ هُمُ الْيَوْمَ مُسْتَسْلِمُونَ"},{"id":3815,"numberInSurah":27,"text_uthmani":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","text_simple":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَاءَلُونَ"},{"id":3816,"numberInSurah":28,"text_uthmani":"قَالُوٓا إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ","text_simple":"قَالُوا إِنَّكُمْ كُنْتُمْ تَأْتُونَنَا عَنِ الْيَمِينِ"},{"id":3817,"numberInSurah":29,"text_uthmani":"قَالُوا بَل لَّمْ تَكُونُوا مُؤْمِنِينَ","text_simple":"قَالُوا بَلْ لَمْ تَكُونُوا مُؤْمِنِينَ"},{"id":3818,"numberInSurah":30,"text_uthmani":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنٍ بَلْ كُنتُمْ قَوْمًا طَٰغِينَ","text_simple":"وَمَا كَانَ لَنَا عَلَيْكُمْ مِنْ سُلْطَانٍ بَلْ كُنْتُمْ قَوْمًا طَاغِينَ"},{"id":3819,"numberInSurah":31,"text_uthmani":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ إِنَّا لَذَآئِقُونَ","text_simple":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَا إِنَّا لَذَائِقُونَ"},{"id":3820,"numberInSurah":32,"text_uthmani":"فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَ","text_simple":"فَأَغْوَيْنَاكُمْ إِنَّا كُنَّا غَاوِينَ"},{"id":3821,"numberInSurah":33,"text_uthmani":"فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ","text_simple":"فَإِنَّهُمْ يَوْمَئِذٍ فِي الْعَذَابِ مُشْتَرِكُونَ"},{"id":3822,"numberInSurah":34,"text_uthmani":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","text_simple":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَ"},{"id":3823,"numberInSurah":35,"text_uthmani":"إِنَّهُمْ كَانُوٓا إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ","text_simple":"إِنَّهُمْ كَانُوا إِذَا قِيلَ لَهُمْ لَا إِلَٰهَ إِلَّا اللَّهُ يَسْتَكْبِرُونَ"},{"id":3824,"numberInSurah":36,"text_uthmani":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍ","text_simple":"وَيَقُولُونَ أَئِنَّا لَتَارِكُو آلِهَتِنَا لِشَاعِرٍ مَجْنُونٍ"},{"id":3825,"numberInSurah":37,"text_uthmani":"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ","text_simple":"بَلْ جَاءَ بِالْحَقِّ وَصَدَّقَ الْمُرْسَلِينَ"},{"id":3826,"numberInSurah":38,"text_uthmani":"إِنَّكُمْ لَذَآئِقُوا ٱلْعَذَابِ ٱلْأَلِيمِ","text_simple":"إِنَّكُمْ لَذَائِقُو الْعَذَابِ الْأَلِيمِ"},{"id":3827,"numberInSurah":39,"text_uthmani":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ","text_simple":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنْتُمْ تَعْمَلُونَ"},{"id":3828,"numberInSurah":40,"text_uthmani":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","text_simple":"إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ"},{"id":3829,"numberInSurah":41,"text_uthmani":"أُولَٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ","text_simple":"أُولَٰئِكَ لَهُمْ رِزْقٌ مَعْلُومٌ"},{"id":3830,"numberInSurah":42,"text_uthmani":"فَوَٰكِهُ وَهُم مُّكْرَمُونَ","text_simple":"فَوَاكِهُ وَهُمْ مُكْرَمُونَ"},{"id":3831,"numberInSurah":43,"text_uthmani":"فِى جَنَّٰتِ ٱلنَّعِيمِ","text_simple":"فِي جَنَّاتِ النَّعِيمِ"},{"id":3832,"numberInSurah":44,"text_uthmani":"عَلَىٰ سُرُرٍ مُّتَقَٰبِلِينَ","text_simple":"عَلَىٰ سُرُرٍ مُتَقَابِلِينَ"},{"id":3833,"numberInSurah":45,"text_uthmani":"يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍ","text_simple":"يُطَافُ عَلَيْهِمْ بِكَأْسٍ مِنْ مَعِينٍ"},{"id":3834,"numberInSurah":46,"text_uthmani":"بَيْضَآءَ لَذَّةٍ لِّلشَّٰرِبِينَ","text_simple":"بَيْضَاءَ لَذَّةٍ لِلشَّارِبِينَ"},{"id":3835,"numberInSurah":47,"text_uthmani":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ","text_simple":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنْزَفُونَ"},{"id":3836,"numberInSurah":48,"text_uthmani":"وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ عِينٌ","text_simple":"وَعِنْدَهُمْ قَاصِرَاتُ الطَّرْفِ عِينٌ"},{"id":3837,"numberInSurah":49,"text_uthmani":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ","text_simple":"كَأَنَّهُنَّ بَيْضٌ مَكْنُونٌ"},{"id":3838,"numberInSurah":50,"text_uthmani":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","text_simple":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَاءَلُونَ"},{"id":3839,"numberInSurah":51,"text_uthmani":"قَالَ قَآئِلٌ مِّنْهُمْ إ