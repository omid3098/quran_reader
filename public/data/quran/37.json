t_uthmani":"لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","text_simple":"لَكُنَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ"},{"id":3958,"numberInSurah":170,"text_uthmani":"فَكَفَرُوا بِهِۦ فَسَوْفَ يَعْلَمُونَ","text_simple":"فَكَفَرُوا بِهِ فَسَوْفَ يَعْلَمُونَ"},{"id":3959,"numberInSurah":171,"text_uthmani":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ","text_simple":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا الْمُرْسَلِينَ"},{"id":3960,"numberInSurah":172,"text_uthmani":"إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ","text_simple":"إِنَّهُمْ لَهُمُ الْمَنْصُورُونَ"},{"id":3961,"numberInSurah":173,"text_uthmani":"وَإِنَّ جُندَنَا لَهُمُ ٱلْغَٰلِبُونَ","text_simple":"وَإِنَّ جُنْدَنَا لَهُمُ الْغَالِبُونَ"},{"id":3962,"numberInSurah":174,"text_uthmani":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ","text_simple":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"id":3963,"numberInSurah":175,"text_uthmani":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ","text_simple":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ"},{"id":3964,"numberInSurah":176,"text_uthmani":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ","text_simple":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"},{"id":3965,"numberInSurah":177,"text_uthmani":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ","text_simple":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَاءَ صَبَاحُ الْمُنْذَرِينَ"},{"id":3966,"numberInSurah":178,"text_uthmani":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ","text_simple":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"id":3967,"numberInSurah":179,"text_uthmani":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ","text_simple":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ"},{"id":3968,"numberInSurah":180,"text_uthmani":"سُبْحَٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ","text_simple":"سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ"},{"id":3969,"numberInSurah":181,"text_uthmani":"وَسَلَٰمٌ عَلَى ٱلْمُرْسَلِينَ","text_simple":"وَسَلَامٌ عَلَى الْمُرْسَلِينَ"},{"id":3970,"numberInSurah":182,"text_uthmani":"وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","text_simple":"وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"}]}