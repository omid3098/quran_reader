 شَجَرَةٌ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ","text_simple":"إِنَّهَا شَجَرَةٌ تَخْرُجُ فِي أَصْلِ الْجَحِيمِ"},{"id":3853,"numberInSurah":65,"text_uthmani":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ","text_simple":"طَلْعُهَا كَأَنَّهُ رُءُوسُ الشَّيَاطِينِ"},{"id":3854,"numberInSurah":66,"text_uthmani":"فَإِنَّهُمْ لَءَاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","text_simple":"فَإِنَّهُمْ لَآكِلُونَ مِنْهَا فَمَالِئُونَ مِنْهَا الْبُطُونَ"},{"id":3855,"numberInSurah":67,"text_uthmani":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ","text_simple":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِنْ حَمِيمٍ"},{"id":3856,"numberInSurah":68,"text_uthmani":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ","text_simple":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى الْجَحِيمِ"},{"id":3857,"numberInSurah":69,"text_uthmani":"إِنَّهُمْ أَلْفَوْا ءَابَآءَهُمْ ضَآلِّينَ","text_simple":"إِنَّهُمْ أَلْفَوْا آبَاءَهُمْ ضَالِّينَ"},{"id":3858,"numberInSurah":70,"text_uthmani":"فَهُمْ عَلَىٰٓ ءَاثَٰرِهِمْ يُهْرَعُونَ","text_simple":"فَهُمْ عَلَىٰ آثَارِهِمْ يُهْرَعُونَ"},{"id":3859,"numberInSurah":71,"text_uthmani":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ","text_simple":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ الْأَوَّلِينَ"},{"id":3860,"numberInSurah":72,"text_uthmani":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ","text_simple":"وَلَقَدْ أَرْسَلْنَا فِيهِمْ مُنْذِرِينَ"},{"id":3861,"numberInSurah":73,"text_uthmani":"فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُنذَرِينَ","text_simple":"فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُنْذَرِينَ"},{"id":3862,"numberInSurah":74,"text_uthmani":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","text_simple":"إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ"},{"id":3863,"numberInSurah":75,"text_uthmani":"وَلَقَدْ نَادَىٰنَا نُوحٌ فَلَنِعْمَ ٱلْمُجِيبُونَ","text_simple":"وَلَقَدْ نَادَانَا نُوحٌ فَلَنِعْمَ الْمُجِيبُونَ"},{"id":3864,"numberInSurah":76,"text_uthmani":"وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ","text_simple":"وَنَجَّيْنَاهُ وَأَهْلَهُ مِنَ الْكَرْبِ الْعَظِيمِ"