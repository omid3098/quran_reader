{"surahId":107,"verses":[{"id":6198,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ أَرَأَيْتَ الَّذِي يُكَذِّبُ بِالدِّينِ"},{"id":6199,"numberInSurah":2,"text_uthmani":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","text_simple":"فَذَٰلِكَ الَّذِي يَدُعُّ الْيَتِيمَ"},{"id":6200,"numberInSurah":3,"text_uthmani":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","text_simple":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ الْمِسْكِينِ"},{"id":6201,"numberInSurah":4,"text_uthmani":"فَوَيْلٌ لِّلْمُصَلِّينَ","text_simple":"فَوَيْلٌ لِلْمُصَلِّينَ"},{"id":6202,"numberInSurah":5,"text_uthmani":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","text_simple":"الَّذِينَ هُمْ عَنْ صَلَاتِهِمْ سَاهُونَ"},{"id":6203,"numberInSurah":6,"text_uthmani":"ٱلَّذِينَ هُمْ يُرَآءُونَ","text_simple":"الَّذِينَ هُمْ يُرَاءُونَ"},{"id":6204,"numberInSurah":7,"text_uthmani":"وَيَمْنَعُونَ ٱلْمَاعُونَ","text_simple":"وَيَمْنَعُونَ الْمَاعُونَ"}]}