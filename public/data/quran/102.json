{"surahId":102,"verses":[{"id":6169,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ أَلْهَاكُمُ التَّكَاثُرُ"},{"id":6170,"numberInSurah":2,"text_uthmani":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","text_simple":"حَتَّىٰ زُرْتُمُ الْمَقَابِرَ"},{"id":6171,"numberInSurah":3,"text_uthmani":"كَلَّا سَوْفَ تَعْلَمُونَ","text_simple":"كَلَّا سَوْفَ تَعْلَمُونَ"},{"id":6172,"numberInSurah":4,"text_uthmani":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","text_simple":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ"},{"id":6173,"numberInSurah":5,"text_uthmani":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","text_simple":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْيَقِينِ"},{"id":6174,"numberInSurah":6,"text_uthmani":"لَتَرَوُنَّ ٱلْجَحِيمَ","text_simple":"لَتَرَوُنَّ الْجَحِيمَ"},{"id":6175,"numberInSurah":7,"text_uthmani":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","text_simple":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَقِينِ"},{"id":6176,"numberInSurah":8,"text_uthmani":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","text_simple":"ثُمَّ لَتُسْأَلُنَّ يَوْمَئِذٍ عَنِ النَّعِيمِ"}]}