{"surahId":93,"verses":[{"id":6080,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالضُّحَىٰ"},{"id":6081,"numberInSurah":2,"text_uthmani":"وَٱلَّيْلِ إِذَا سَجَىٰ","text_simple":"وَاللَّيْلِ إِذَا سَجَىٰ"},{"id":6082,"numberInSurah":3,"text_uthmani":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","text_simple":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"},{"id":6083,"numberInSurah":4,"text_uthmani":"وَلَلْءَاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","text_simple":"وَلَلْآخِرَةُ خَيْرٌ لَكَ مِنَ الْأُولَىٰ"},{"id":6084,"numberInSurah":5,"text_uthmani":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","text_simple":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ"},{"id":6085,"numberInSurah":6,"text_uthmani":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ","text_simple":"أَلَمْ يَجِدْكَ يَتِيمًا فَآوَىٰ"},{"id":6086,"numberInSurah":7,"text_uthmani":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ","text_simple":"وَوَجَدَكَ ضَالًّا فَهَدَىٰ"},{"id":6087,"numberInSurah":8,"text_uthmani":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ","text_simple":"وَوَجَدَكَ عَائِلًا فَأَغْنَىٰ"},{"id":6088,"numberInSurah":9,"text_uthmani":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","text_simple":"فَأَمَّا الْيَتِيمَ فَلَا تَقْهَرْ"},{"id":6089,"numberInSurah":10,"text_uthmani":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","text_simple":"وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ"},{"id":6090,"numberInSurah":11,"text_uthmani":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","text_simple":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"}]}