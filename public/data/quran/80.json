{"surahId":80,"verses":[{"id":5759,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ عَبَسَ وَتَوَلَّىٰ"},{"id":5760,"numberInSurah":2,"text_uthmani":"أَن جَآءَهُ ٱلْأَعْمَىٰ","text_simple":"أَنْ جَاءَهُ الْأَعْمَىٰ"},{"id":5761,"numberInSurah":3,"text_uthmani":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","text_simple":"وَمَا يُدْرِيكَ لَعَلَّهُ يَزَّكَّىٰ"},{"id":5762,"numberInSurah":4,"text_uthmani":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","text_simple":"أَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرَىٰ"},{"id":5763,"numberInSurah":5,"text_uthmani":"أَمَّا مَنِ ٱسْتَغْنَىٰ","text_simple":"أَمَّا مَنِ اسْتَغْنَىٰ"},{"id":5764,"numberInSurah":6,"text_uthmani":"فَأَنتَ لَهُۥ تَصَدَّىٰ","text_simple":"فَأَنْتَ لَهُ تَصَدَّىٰ"},{"id":5765,"numberInSurah":7,"text_uthmani":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","text_simple":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"},{"id":5766,"numberInSurah":8,"text_uthmani":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","text_simple":"وَأَمَّا مَنْ جَاءَكَ يَسْعَىٰ"},{"id":5767,"numberInSurah":9,"text_uthmani":"وَهُوَ يَخْشَىٰ","text_simple":"وَهُوَ يَخْشَىٰ"},{"id":5768,"numberInSurah":10,"text_uthmani":"فَأَنتَ عَنْهُ تَلَهَّىٰ","text_simple":"فَأَنْتَ عَنْهُ تَلَهَّىٰ"},{"id":5769,"numberInSurah":11,"text_uthmani":"كَلَّآ إِنَّهَا تَذْكِرَةٌ","text_simple":"كَلَّا إِنَّهَا تَذْكِرَةٌ"},{"id":5770,"numberInSurah":12,"text_uthmani":"فَمَن شَآءَ ذَكَرَهُۥ","text_simple":"فَمَنْ شَاءَ ذَكَرَهُ"},{"id":5771,"numberInSurah":13,"text_uthmani":"فِى صُحُفٍ مُّكَرَّمَةٍ","text_simple":"فِي صُحُفٍ مُكَرَّمَةٍ"},{"id":5772,"numberInSurah":14,"text_uthmani":"مَّرْفُوعَةٍ مُّطَهَّرَةٍ","text_simple":"مَرْفُوعَةٍ مُطَهَّرَةٍ"},{"id":5773,"numberInSurah":15,"text_uthmani":"بِأَيْدِى سَفَرَةٍ","text_simple":"بِأَيْدِي سَفَرَةٍ"},{"id":5774,"numberInSurah":16,"text_uthmani":"كِرَامٍ بَرَرَةٍ","text_simple":"كِرَامٍ بَرَرَةٍ"},{"id":5775,"numberInSurah":17,"text_uthmani":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","text_simple":"قُتِلَ الْإِنْسَانُ مَا أَكْفَرَهُ"},{"id":5776,"numberInSurah":18,"text_uthmani":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","text_simple":"مِنْ أَيِّ شَيْءٍ خَلَقَهُ"},{"id":5777,"numberInSurah":19,"text_uthmani":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","text_simple":"مِنْ نُطْفَةٍ خَلَقَهُ فَقَدَّرَهُ"},{"id":5778,"numberInSurah":20,"text_uthmani":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","text_simple":"ثُمَّ السَّبِيلَ يَسَّرَهُ"},{"id":5779,"numberInSurah":21,"text_uthmani":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","text_simple":"ثُمَّ أَمَاتَهُ فَأَقْبَرَهُ"},{"id":5780,"numberInSurah":22,"text_uthmani":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","text_simple":"ثُمَّ إِذَا شَاءَ أَنْشَرَهُ"},{"id":5781,"numberInSurah":23,"text_uthmani":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","text_simple":"كَلَّا لَمَّا يَقْضِ مَا أَمَرَهُ"},{"id":5782,"numberInSurah":24,"text_uthmani":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","text_simple":"فَلْيَنْظُرِ الْإِنْسَانُ إِلَىٰ طَعَامِهِ"},{"id":5783,"numberInSurah":25,"text_uthmani":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا","text_simple":"أَنَّا صَبَبْنَا الْمَاءَ صَبًّا"},{"id":5784,"numberInSurah":26,"text_uthmani":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا","text_simple":"ثُمَّ شَقَقْنَا الْأَرْضَ شَقًّا"},{"id":5785,"numberInSurah":27,"text_uthmani":"فَأَنبَتْنَا فِيهَا حَبًّا","text_simple":"فَأَنْبَتْنَا فِيهَا حَبًّا"},{"id":5786,"numberInSurah":28,"text_uthmani":"وَعِنَبًا وَقَضْبًا","text_simple":"وَعِنَبًا وَقَضْبًا"},{"id":5787,"numberInSurah":29,"text_uthmani":"وَزَيْتُونًا وَنَخْلًا","text_simple":"وَزَيْتُونًا وَنَخْلًا"},{"id":5788,"numberInSurah":30,"text_uthmani":"وَحَدَآئِقَ غُلْبًا","text_simple":"وَحَدَائِقَ غُلْبًا"},{"id":5789,"numberInSurah":31,"text_uthmani":"وَفَٰكِهَةً وَأَبًّا","text_simple":"وَفَاكِهَةً وَأَبًّا"},{"id":5790,"numberInSurah":32,"text_uthmani":"مَّتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ","text_simple":"مَتَاعًا لَكُمْ وَلِأَنْعَامِكُمْ"},{"id":5791,"numberInSurah":33,"text_uthmani":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","text_simple":"فَإِذَا جَاءَتِ الصَّاخَّةُ"},{"id":5792,"numberInSurah":34,"text_uthmani":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","text_simple":"يَوْمَ يَفِرُّ الْمَرْءُ مِنْ أَخِيهِ"},{"id":5793,"numberInSurah":35,"text_uthmani":"وَأُمِّهِۦ وَأَبِيهِ","text_simple":"وَأُمِّهِ وَأَبِيهِ"},{"id":5794,"numberInSurah":36,"text_uthmani":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","text_simple":"وَصَاحِبَتِهِ وَبَنِيهِ"},{"id":5795,"numberInSurah":37,"text_uthmani":"لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ","text_simple":"لِكُلِّ امْرِئٍ مِنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ"},{"id":5796,"numberInSurah":38,"text_uthmani":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ","text_simple":"وُجُوهٌ يَوْمَئِذٍ مُسْفِرَةٌ"},{"id":5797,"numberInSurah":39,"text_uthmani":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ","text_simple":"ضَاحِكَةٌ مُسْتَبْشِرَةٌ"},{"id":5798,"numberInSurah":40,"text_uthmani":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ","text_simple":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ"},{"id":5799,"numberInSurah":41,"text_uthmani":"تَرْهَقُهَا قَتَرَةٌ","text_simple":"تَرْهَقُهَا قَتَرَةٌ"},{"id":5800,"numberInSurah":42,"text_uthmani":"أُولَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","text_simple":"أُولَٰئِكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ"}]}