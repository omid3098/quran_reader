{"surahId":101,"verses":[{"id":6158,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الْقَارِعَةُ"},{"id":6159,"numberInSurah":2,"text_uthmani":"مَا ٱلْقَارِعَةُ","text_simple":"مَا الْقَارِعَةُ"},{"id":6160,"numberInSurah":3,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","text_simple":"وَمَا أَدْرَاكَ مَا الْقَارِعَةُ"},{"id":6161,"numberInSurah":4,"text_uthmani":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","text_simple":"يَوْمَ يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِ"},{"id":6162,"numberInSurah":5,"text_uthmani":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","text_simple":"وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوشِ"},{"id":6163,"numberInSurah":6,"text_uthmani":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","text_simple":"فَأَمَّا مَنْ ثَقُلَتْ مَوَازِينُهُ"},{"id":6164,"numberInSurah":7,"text_uthmani":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","text_simple":"فَهُوَ فِي عِيشَةٍ رَاضِيَةٍ"},{"id":6165,"numberInSurah":8,"text_uthmani":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","text_simple":"وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ"},{"id":6166,"numberInSurah":9,"text_uthmani":"فَأُمُّهُۥ هَاوِيَةٌ","text_simple":"فَأُمُّهُ هَاوِيَةٌ"},{"id":6167,"numberInSurah":10,"text_uthmani":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","text_simple":"وَمَا أَدْرَاكَ مَا هِيَهْ"},{"id":6168,"numberInSurah":11,"text_uthmani":"نَارٌ حَامِيَةٌ","text_simple":"نَارٌ حَامِيَةٌ"}]}