{"surahId":109,"verses":[{"id":6208,"numberInSurah":1,"text_uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","text_simple":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ قُلْ يَا أَيُّهَا الْكَافِرُونَ"},{"id":6209,"numberInSurah":2,"text_uthmani":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","text_simple":"لَا أَعْبُدُ مَا تَعْبُدُونَ"},{"id":6210,"numberInSurah":3,"text_uthmani":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","text_simple":"وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ"},{"id":6211,"numberInSurah":4,"text_uthmani":"وَلَآ أَنَا عَابِدٌ مَّا عَبَدتُّمْ","text_simple":"وَلَا أَنَا عَابِدٌ مَا عَبَدْتُمْ"},{"id":6212,"numberInSurah":5,"text_uthmani":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","text_simple":"وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ"},{"id":6213,"numberInSurah":6,"text_uthmani":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","text_simple":"لَكُمْ دِينُكُمْ وَلِيَ دِينِ"}]}